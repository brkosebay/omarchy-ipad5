#!/bin/bash
# /init of the crash kernel (linux-a9-kexec panic-load packs it, with the
# next kernel in /stage2). A panic in the main kernel lands here, in the
# crashkernel= memory only, with one CPU. By the time this runs, the
# built-in drivers have attempted to reset PCIe (NVMe, Wi-Fi), the DARTs
# and USB. reset_devices is a request, not proof that every device reset.
# NVMe is read-only
# here (no nvme.write_window). Then kexec into the full system with all of
# RAM. Nothing here resets the SoC: that would boot iOS.
export PATH=/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
exec </dev/console >/dev/console 2>&1

say() { echo "phoenix: $*"; echo "<2>phoenix: $*" >/dev/kmsg 2>/dev/null; }
halt_here() {
	say "$*; halting (a SoC reset would boot iOS: power-cycle and boot through the Mac)"
	while :; do sleep 3600; done
}

delay=5
for w in $(cat /proc/cmdline); do
	case "$w" in linux_a9.phoenix_delay=*) delay=${w#*=} ;; esac
done

. /stage2/args
. /phoenix-storage
phoenix_storage || halt_here "storage quiesce failed"
say "kernel panic: restarting Linux ($STAGE2_ENTRY) in ${delay}s"
sleep "$delay"

initrd=()
[ -f /stage2/initrd ] && initrd=(--initrd=/stage2/initrd)
if [ -f /stage2/dtb ]; then
    kexec -c -l /stage2/Image "${initrd[@]}" --dtb=/stage2/dtb --command-line="$STAGE2_CMDLINE" ||
		halt_here "loading $STAGE2_ENTRY failed"
else
	# The crash kernel's FDT minus linux,usable-memory-range/elfcorehdr
	# (drivers/of/kexec.c drops them for a normal image): all RAM again.
	kexec -s -l /stage2/Image "${initrd[@]}" --command-line="$STAGE2_CMDLINE" ||
		halt_here "loading $STAGE2_ENTRY failed"
fi
kexec -e
halt_here "kexec -e returned"
