#!/usr/bin/python3
"""Recover a previously live USB gadget link after sustained carrier loss."""
import fcntl
from pathlib import Path
import signal
import time


def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ''


class Recovery:
    def __init__(self, sysfs=Path('/sys'), pause=time.sleep, log=print):
        self.sysfs, self.pause, self.log = sysfs, pause, log
        self.seen_carrier = False
        self.lost_at = None
        self.retry_after = 0
        self.attempts = 0

    def binding(self):
        """Only the bound gadget with an active ECM function owning usb0."""
        matches = []
        for gadget in (self.sysfs / 'kernel/config/usb_gadget').glob('*'):
            udc = read(gadget / 'UDC')
            if not udc or '/' in udc:
                continue
            for function in (gadget / 'functions').glob('ecm.*'):
                if read(function / 'ifname') != 'usb0':
                    continue
                if any(link.is_symlink() and link.resolve() == function.resolve()
                       for link in (gadget / 'configs').glob('*/*')):
                    matches.append((gadget / 'UDC', udc))
        return matches[0] if len(matches) == 1 else None

    def ready(self):
        supply = self.sysfs / 'class/power_supply/usb'
        net = self.sysfs / 'class/net/usb0'
        try:
            # A zero allowance is normal during USB suspend. Let the host wake it.
            return (read(supply / 'online') == '1' and
                    int(read(supply / 'current_max')) > 0 and
                    int(read(net / 'flags'), 16) & 1 and
                    read(net / 'carrier') == '0')
        except ValueError:
            return False

    def step(self, now):
        net = self.sysfs / 'class/net/usb0'
        if read(self.sysfs / 'class/power_supply/usb/online') == '0':
            self.seen_carrier = False
            self.attempts = 0
            self.lost_at = None
            self.retry_after = 0
            return
        if read(net / 'carrier') == '1':
            self.seen_carrier = True
            self.lost_at = None
            return
        if not self.seen_carrier or not self.ready():
            self.lost_at = None
            return
        if self.lost_at is None:
            self.lost_at = now
        if now - self.lost_at < 10 or now < self.retry_after or self.attempts >= 3:
            return
        binding = self.binding()
        if not binding:
            return
        path, udc = binding
        if read(self.sysfs / 'class/udc' / udc / 'state') != 'configured':
            return
        # Recheck immediately before disconnecting; never adopt an unbound gadget.
        if not self.ready() or read(path) != udc:
            return
        self.attempts += 1
        self.retry_after = now + 60
        self.log(f'usb0 carrier lost with VBUS present; rebinding {udc} '
                 f'(attempt {self.attempts}/3)', flush=True)
        try:
            path.write_text('\n')
            try:
                self.pause(0.2)
            finally:
                # Restore even on stop/error, but do not overwrite another owner.
                if read(path) == '':
                    path.write_text(udc + '\n')
        except OSError as error:
            self.log(f'USB gadget rebind failed: {error}', flush=True)
        self.lost_at = None


def main():
    running = True

    def stop(_signum, _frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    # systemd supplies the directory; also prevent a second manual instance.
    with open('/run/linux-a9-usb-recover/lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        recovery = Recovery()
        while running:
            recovery.step(time.monotonic())
            if running:
                time.sleep(2)


if __name__ == '__main__':
    main()
