# linux-a9: ambient-light auto-brightness (ipad-als-brightness --help).
# Starts only where the kernel has an IIO light sensor (the CT819 once its
# driver is in), and then does nothing until switched on (the bar button, the
# iPad Screen menu, `ipad-als-brightness on`). A condition that fails at login
# isn't retried: after loading a driver by hand,
# `systemctl --user start ipad-als-brightness`.
[Unit]
Description=linux-a9 iPad ambient-light auto-brightness
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExistsGlob=|/sys/bus/iio/devices/iio:device*/in_illuminance_input
ConditionPathExistsGlob=|/sys/bus/iio/devices/iio:device*/in_illuminance_raw

[Service]
ExecStart=/usr/local/bin/ipad-als-brightness
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
