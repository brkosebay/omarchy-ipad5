# linux-a9: touch gestures for the iPad (ipad-gestures --help).
[Unit]
Description=linux-a9 iPad touch gestures
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/ipad-gestures
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
