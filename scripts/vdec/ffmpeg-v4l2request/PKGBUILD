# linux-a9 round 7: Arch Linux ARM's ffmpeg 2:9.0.2-2 (archlinuxarm/PKGBUILDs
# 72248ab7d3, extra/ffmpeg) plus the V4L2 Request API hwaccels, so that mpv
# (--hwdec=v4l2request-copy) and the ffmpeg CLI (-hwaccel v4l2request) can use
# the iPad's apple-vxd stateless decoder.
#
# Changes against ALARM's PKGBUILD, nothing else:
#  - pkgrel 2 -> 2.1, arch aarch64, source is the signed release tarball
#    (signature checked by scripts/vdec/build-ffmpeg-pkg.sh, sum pinned here)
#  - the 13 patches of Kwiboo/FFmpeg branch v4l2-request-n8.1 (b57fbbe50c,
#    2026-03-16; Jonas Karlman, Jernej Skrabec, Boris Brezillon), rebased to
#    n9.0.2 with context reduced to one line (no hunk changed)
#  - configure --enable-v4l2-request --enable-libudev; depends on systemd-libs
#  - no --enable-cuda-llvm and no clang: ALARM already drops ffnvcodec-headers
#    (so no CUDA filter is built); the flag only made configure look for
#    clang.  build-ffmpeg-pkg.sh checks the decoder, encoder, filter, muxer,
#    demuxer, protocol and bsf lists are identical to the stock package's.
#  - glslang listed in makedepends: FFmpeg 9 compiles its Vulkan shaders at
#    build time (ALARM's builder gets it through libplacebo; without it every
#    *_vulkan filter, encoder and hwaccel silently disappears)
#
# ABI: the only public change is AV_HWDEVICE_TYPE_V4L2REQUEST appended to
# enum AVHWDeviceType (libavutil/hwcontext.h); sonames are unchanged, so every
# package built against the stock ffmpeg keeps working (the build script
# checks sonames, NEEDED and exported symbols against the stock package).
#
# Original maintainers:
# Maintainer: Maxime Gauduin <maintainer@example.invalid>
# Contributor: Bartłomiej Piotrowski <maintainer@example.invalid>
# Contributor: Ionut Biru <maintainer@example.invalid>
# Contributor: Tom Newsom <maintainer@example.invalid>
# Contributor: Paul Mattal <maintainer@example.invalid>
# ALARM: Kevin Mihelich <maintainer@example.invalid>

pkgname=ffmpeg
pkgver=9.0.2
pkgrel=2.1
epoch=2
pkgdesc='Complete solution to record, convert and stream audio and video (V4L2 Request API hwaccels, linux-a9)'
arch=(aarch64)
url=https://ffmpeg.org
license=(GPL-3.0-only)
