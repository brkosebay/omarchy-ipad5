  'avisynthplus: AviSynthPlus support'
  'frei0r-plugins: Frei0r video effects support'
  'ladspa: LADSPA filters'
)
provides=(
  libavcodec.so
  libavdevice.so
  libavfilter.so
  libavformat.so
  libavutil.so
  libswresample.so
  libswscale.so
)
_v4l2request=(
  v4l2request-0001-avutil-hwcontext-Add-hwdevice-type-for-V4L2-Request-.patch
  v4l2request-0002-avutil-hwcontext_v4l2request-Probe-for-a-capable-med.patch
  v4l2request-0003-avcodec-Add-common-V4L2-Request-API-code.patch
  v4l2request-0004-avcodec-v4l2request-Add-common-decode-support-for-hw.patch
  v4l2request-0005-avcodec-Add-V4L2-Request-API-mpeg2-hwaccel.patch
  v4l2request-0006-avcodec-h264dec-add-ref_pic_marking-and-pic_order_cn.patch
  v4l2request-0007-avcodec-Add-V4L2-Request-API-h264-hwaccel.patch
  v4l2request-0008-avcodec-Add-V4L2-Request-API-hevc-hwaccel.patch
  v4l2request-0009-avcodec-Add-V4L2-Request-API-vp8-hwaccel.patch
  v4l2request-0010-avcodec-Add-V4L2-Request-API-vp9-hwaccel.patch
  v4l2request-0011-avcodec-Add-V4L2-Request-API-av1-hwaccel.patch
  v4l2request-0012-avutil-hwcontext_v4l2request-Add-support-for-AFBC_16.patch
  v4l2request-0013-avutil-hwcontext_v4l2request-Add-support-for-BROADCO.patch
)
source=(
  https://ffmpeg.org/releases/ffmpeg-${pkgver}.tar.xz
  0001-Add-av_stream_get_first_dts-for-Chromium.patch
  "${_v4l2request[@]}"
)
