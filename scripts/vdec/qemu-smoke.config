# QEMU virt smoke-test kernel for the apple-vxd V4L2 paths (allnoconfig
# base, see scripts/vdec/qemu-smoke.sh).  Not a device config: the VXD is a
# RAM-backed stand-in, so this only exercises driver logic (probe, the
# V4L2 self-test, open/ioctl/release, the no-firmware job path, debugfs).
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_GIC_V3=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_MULTIUSER=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_PM=y
CONFIG_FW_LOADER=y
CONFIG_CRYPTO_LIB_SHA256=y
CONFIG_COMPILE_TEST=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_APPLE_VXD=y
# Catch what the device cannot report: UAF/double free, sleeping in
# atomic context, lock misuse.
CONFIG_DEBUG_KERNEL=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_LIST=y
CONFIG_PANIC_ON_OOPS=y
# /dev/mem for scripts/vdec/vxd-fake-mtx.c (the stand-in register window
# sits above mem=, so it is not System RAM; no STRICT_DEVMEM filter).
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
