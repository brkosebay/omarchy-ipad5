<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- AppleSEPUserClient::initWithTask requires this before the user
         client can be opened. -->
    <key>com.apple.private.applesepmanager.allow</key>
    <true/>

    <!-- Standard jailbroken CLI / IOKit user-client access. -->
    <key>platform-application</key>
    <true/>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AppleSEPUserClient</string>
    </array>
</dict>
</plist>
