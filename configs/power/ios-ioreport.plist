<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Launch envelope that worked in sample-2. powerd uses the first IOKit
         spelling; powerdatad and thermalmonitord use the exception spelling.
         The helper still needs its own successful iOS subscription test. -->
    <key>platform-application</key><true/>
    <key>com.apple.private.security.no-container</key><true/>
    <key>com.apple.private.security.no-sandbox</key><true/>
    <key>com.apple.security.iokit-user-client-class</key>
    <array><string>IOReportUserClient</string></array>
    <key>com.apple.security.exception.iokit-user-client-class</key>
    <array><string>IOReportUserClient</string></array>
</dict>
</plist>
