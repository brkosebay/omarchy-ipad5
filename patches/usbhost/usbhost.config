# Lightning port USB host mode (a9/usbhost): role switch, EHCI/OHCI, and
# what flash drives need. See docs/periph/usb-host-test-plan.md.
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_ROLES_APPLE_S8000=y
CONFIG_PHY_APPLE_AUSB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXFAT_FS=y
