+static void sep_msg64_cmd(const char* cmd, char* args)
+{
+    /* sep msg64 <ep> <tag> <op> <param> <data>, all hex; A9 only. */
+    if (!*args) {
+        iprintf("usage: sep msg64 <ep> <tag> <op> <param> <data>\n");
+        return;
+    }
+    char* a[4];
+    char* p = args;
+    for (int i = 0; i < 4; i++) {
+        a[i] = command_tokenize(p, 0x1ff - (p - cmd));
+        if (!*a[i]) { iprintf("need 5 arguments\n"); return; }
+        p = a[i];
+    }
+    union sep_message_u msg = { .msg = {
+        .ep = strtoul(args, NULL, 16),
+        .tag = strtoul(a[0], NULL, 16),
+        .opcode = strtoul(a[1], NULL, 16),
+        .param = strtoul(a[2], NULL, 16),
+        .data = strtoul(a[3], NULL, 16),
+    }};
+
+    if (is_sep64) {
+        iprintf("sep msg64: A9 32-bit wrapper layout only; refusing\n");
+        return;
+    }
+
+    uint32_t snd_sts = mailboxregs32->snd_sts;
+    if (!(snd_sts & 0x20000)) {
+        iprintf("sep msg64: AP->SEP FIFO not empty (snd_sts=%x); not sent\n",
+                snd_sts);
+        return;
+    }
+    sep_log_msgs = true;
+    iprintf("AP->SEP64 ep=%x tag=%x op=%x param=%x data=%x raw=%llx\n",
+            msg.msg.ep, msg.msg.tag, msg.msg.opcode, msg.msg.param,
+            msg.msg.data, msg.val);
+    disable_interrupts();
+    mailbox_write_a9_single64(msg.val);
+    enable_interrupts();
+    for (int i = 0; i < 100; i++) {
+        spin(1000);
+    }
+}
