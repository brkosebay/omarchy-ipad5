+/* Never pass firmware or calibration payloads to these diagnostic helpers. */
+static void n1_dump_error(struct apple_n1 *n1, const char *phase,
+			  const u8 *packet, size_t len)
+{
+	size_t offset;
+
+	for (offset = 0; offset < len; offset += 32)
+		dev_err(&n1->spi->dev, "%s rx[%zu/%zu]: %*ph\n", phase,
+			offset, len, (int)min_t(size_t, 32, len - offset), packet + offset);
+}
+
+static int n1_control_xfer(struct apple_n1 *n1, const char *phase, size_t len)
+{
+	bool log = READ_ONCE(trace) && n1->traced_controls < 64;
+	int ret;
+
+	n1->control_length = len;
+	if (log) {
+		n1->traced_controls++;
+		dev_info(&n1->spi->dev, "trace %s tx[%zu]: %*ph\n", phase,
+			 len, (int)min_t(size_t, len, 32), n1->tx);
+	}
+	ret = n1_xfer(n1, len);
+	if (ret)
+		dev_err(&n1->spi->dev, "%s transfer (%zu bytes) failed: %d\n",
+			phase, len, ret);
+	if (log)
+		dev_info(&n1->spi->dev, "trace %s rx[%zu] ret=%d: %*ph\n", phase,
+			 len, ret, (int)min_t(size_t, len, 32), n1->rx);
+	return ret;
+}
+
+static int n1_check_control(struct apple_n1 *n1, u8 command, u8 id, size_t len)
+{
+	u16 received = get_unaligned_le16(n1->rx + len - 2);
+	u16 calculated = n1_sum(n1->rx, len - 2);
+
+	if (n1->rx[0] == command && received == calculated)
+		return 0;
+	dev_err(&n1->spi->dev,
+		"control %02x/%02x %s mismatch: echo=%02x expected=%02x checksum=%04x calculated=%04x\n",
+		command, id, n1->rx[0] != command ? "echo" : "checksum",
+		n1->rx[0], command, received, calculated);
+	n1_dump_error(n1, "control", n1->rx, len);
+	return -EBADMSG;
+}
+
