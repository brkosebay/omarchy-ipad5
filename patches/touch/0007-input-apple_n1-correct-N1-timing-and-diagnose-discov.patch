+static int n1_get_report(struct apple_n1 *n1, u8 id, u8 *data, size_t minimum)
+{
+	int ret, attempt;
+
+	/* iOS delays every GET invocation by 2ms and retries corrupt replies.
+	 * Use one aggregate budget instead of its nested E3/GET retry budgets.
+	 * Transport timeouts and valid unsupported/malformed descriptors abort.
+	 */
+	for (attempt = 0; attempt < N1_RETRIES; attempt++) {
+		usleep_range(2000, 3000);
+		ret = n1_get_report_once(n1, id, data, minimum);
+		if (ret != -EBADMSG)
+			return ret;
+		dev_err(&n1->spi->dev, "report %02x attempt %d/%u failed: %d\n",
+			id, attempt + 1, N1_RETRIES, ret);
+		if (attempt + 1 < N1_RETRIES)
+			usleep_range(1000, 2000);
+	}
+	return ret;
+}
