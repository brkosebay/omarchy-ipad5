 	n1->max_packet = get_unaligned_le16(n1->rx + 3);
-	if (n1->rx[2] != 1 || n1->max_packet < 16 || n1->max_packet > N1_FRAME_MAX)
+	if (n1->rx[2] != 1 || n1->max_packet < 16 || n1->max_packet > N1_FRAME_MAX) {
+		dev_err(&n1->spi->dev, "E2 interface=%u expected=1 max-packet=%u expected=16..%u\n",
+			n1->rx[2], n1->max_packet, N1_FRAME_MAX);
