# linux-a9 touch workstream: options merged by scripts/integrate.sh
# Validated against a9/touch 6ca4db7756. Keep parent subsystems explicit:
# olddefconfig otherwise silently drops N1 and the analog regulator.
# Normal boots need no apple_n1 parameters: default boot_stage=3, trace=N.
# Use boot_stage=1 only for staged diagnostics.
CONFIG_REGULATOR=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_OF=y
CONFIG_GPIOLIB=y
CONFIG_COMMON_CLK=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_APPLE=y
CONFIG_SPI_APPLE_S8000=y
CONFIG_I2C=y
CONFIG_I2C_APPLE=y
CONFIG_MFD_SIMPLE_MFD_I2C=y
CONFIG_COMMON_CLK_APPLE_S8000_TOUCH=y
CONFIG_REGULATOR_APPLE_D2365_TOUCH=y
CONFIG_TOUCHSCREEN_APPLE_N1=y
