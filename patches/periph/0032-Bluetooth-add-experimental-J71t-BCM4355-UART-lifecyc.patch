From 968128fbc5d45d4574e1645c6bedf0ef5fda95fd Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 09:54:05 +0000
Subject: [PATCH 32/55] Bluetooth: add experimental J71t BCM4355 UART lifecycle

Port Pauli1Go J172 power/baud sequencing to an explicitly gated A9 compatible. A9 UBRDIV oversampling and ROM initial speed are inferred from T8010 and require hardware validation. Do not assert C0/C1 from the n88 ADT identity. Include the BCM4355C0 default-address detection from Pauli1Go dea7a97c9a6f.
---
 .../devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml    | 1 +
 Documentation/devicetree/bindings/serial/samsung_uart.yaml   | 4 +++-
 drivers/bluetooth/btbcm.c                                    | 5 +++++
 drivers/bluetooth/hci_bcm.c                                  | 3 +++
 drivers/tty/serial/samsung_tty.c                             | 2 ++
 5 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml b/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml
index 8f043322f8..0a2bf4fb37 100644
--- a/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml
+++ b/Documentation/devicetree/bindings/net/bluetooth/brcm,bluetooth.yaml
@@ -15,6 +15,7 @@ description:
 properties:
   compatible:
     oneOf:
+      - const: apple,j71t-bcm4355-bt
       - items:
           - const: apple,j172-bcm4355c1-bt
           - const: brcm,bcm4355c1-bt
diff --git a/Documentation/devicetree/bindings/serial/samsung_uart.yaml b/Documentation/devicetree/bindings/serial/samsung_uart.yaml
index df763d5aee..68542bd1b4 100644
--- a/Documentation/devicetree/bindings/serial/samsung_uart.yaml
+++ b/Documentation/devicetree/bindings/serial/samsung_uart.yaml
@@ -29,7 +29,9 @@ properties:
           - samsung,exynos850-uart
           - samsung,exynos8895-uart
       - items:
-          - const: apple,t8010-uart
+          - enum:
+              - apple,s8000-uart
+              - apple,t8010-uart
           - const: apple,s5l-uart
       - items:
           - const: samsung,exynos2200-uart
diff --git a/drivers/bluetooth/btbcm.c b/drivers/bluetooth/btbcm.c
index 31a81da918..fc4d33cf43 100644
--- a/drivers/bluetooth/btbcm.c
+++ b/drivers/bluetooth/btbcm.c
@@ -30,6 +30,7 @@
 #define BDADDR_BCM4330B1 (&(bdaddr_t) {{0x00, 0x00, 0x00, 0xb1, 0x30, 0x43}})
 #define BDADDR_BCM4334B0 (&(bdaddr_t) {{0x00, 0x00, 0x00, 0xb0, 0x34, 0x43}})
 #define BDADDR_BCM4345C5 (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0xc5, 0x45, 0x43}})
+#define BDADDR_BCM4355C0 (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0xc0, 0x55, 0x43}})
 #define BDADDR_BCM4355C1 (&(bdaddr_t) {{0x93, 0x76, 0x00, 0xc1, 0x55, 0x43}})
 #define BDADDR_BCM43341B (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0x1b, 0x34, 0x43}})
 
@@ -122,6 +123,9 @@ int btbcm_check_bdaddr(struct hci_dev *hdev)
 	 * The address AA:AA:AA:AA:AA:AA indicates a BCM43430A1 controller
 	 * with no configured address.
 	 *
+	 * The address 43:55:C0:00:1F:AC indicates a BCM4355C0 controller
+	 * with no configured address.
+	 *
 	 * The address 43:55:C1:00:76:93 indicates a BCM4355C1 controller
 	 * with no configured address.
 	 */
@@ -132,6 +136,7 @@ int btbcm_check_bdaddr(struct hci_dev *hdev)
 	    !bacmp(&bda->bdaddr, BDADDR_BCM4330B1) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM4334B0) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM4345C5) ||
+	    !bacmp(&bda->bdaddr, BDADDR_BCM4355C0) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM4355C1) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM43430A0) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM43430A1) ||
diff --git a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
index 8b2c808a55..7d93b4da82 100644
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -1677,6 +1677,9 @@ static const struct of_device_id bcm_bluetooth_of_match[] = {
 	{ .compatible = "brcm,bcm43438-bt", .data = &bcm43438_device_data },
 	{ .compatible = "brcm,bcm4349-bt", .data = &bcm43438_device_data },
 	{ .compatible = "brcm,bcm43540-bt", .data = &bcm4354_device_data },
+	/* A9 module revision is selected by ROM and board-specific firmware. */
+	{ .compatible = "apple,j71t-bcm4355-bt",
+	  .data = &bcm4355_j172_device_data },
 	{ .compatible = "apple,j172-bcm4355c1-bt",
 	  .data = &bcm4355_j172_device_data },
 	{ .compatible = "brcm,bcm4355c1-bt", .data = &bcm4355_device_data },
diff --git a/drivers/tty/serial/samsung_tty.c b/drivers/tty/serial/samsung_tty.c
index 498abfb041..485059f950 100644
--- a/drivers/tty/serial/samsung_tty.c
+++ b/drivers/tty/serial/samsung_tty.c
@@ -2719,6 +2719,8 @@ static const struct of_device_id s3c24xx_uart_dt_match[] = {
 		.data = EXYNOS5433_SERIAL_DRV_DATA },
 	{ .compatible = "apple,s5l-uart",
 		.data = S5L_SERIAL_DRV_DATA },
+	{ .compatible = "apple,s8000-uart",
+		.data = T8010_SERIAL_DRV_DATA },
 	{ .compatible = "apple,t8010-uart",
 		.data = T8010_SERIAL_DRV_DATA },
 	{ .compatible = "samsung,exynos850-uart",
