From 14cc7fc330e770a37135776ffcc4663a38d4eab0 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Sat, 24 Oct 2026 00:31:51 +0000
Subject: [PATCH 1/3] dt-bindings: power: supply: apple: describe J71t input
 ceilings

Describe the calibrated board maximum and this development unit's explicit
owner limit separately. The driver validates both against its supported
CBAT budgets, with a 500 mA fallback for absent/unsupported board ceilings.

Signed-off-by: linux-a9 <linux-a9@localhost>
---
 .../bindings/power/supply/apple,d2365-charger.yaml   | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
index e6a21d3917..59aee44205 100644
--- a/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
@@ -37,6 +37,18 @@ properties:
   power-supplies:
     maxItems: 1
 
+  apple,usb-input-limit-max-microamp:
+    description: Board input ceiling, from the ADT usb-input-limit-max value.
+    enum: [500000, 1000000, 2100000, 2400000]
+    default: 500000
+
+  apple,owner-input-limit-microamp:
+    description: |
+      Owner-authorized input ceiling for this development unit's USB host.
+      Requires an enumerated host or a detected brick and valid CBAT codes;
+      the board ceiling still applies. Omission leaves source-based policy.
+    enum: [500000, 1000000, 2100000, 2400000]
+
 required:
   - compatible
   - reg
