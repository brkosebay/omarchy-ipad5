+		ret = -ERANGE;
 		goto out;
 	}
 	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_TEMP, &value);
-	if (ret || value.intval < 100 || value.intval > 400) {
-		ret = ret ?: -ERANGE;
