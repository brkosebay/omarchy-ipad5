-	}
-	ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_VOLTAGE_NOW, &value);
-	if (!ret && (value.intval < 3000000 || value.intval > 4200000))
-		ret = -ERANGE;
+	if (ret)
+		goto transient;
