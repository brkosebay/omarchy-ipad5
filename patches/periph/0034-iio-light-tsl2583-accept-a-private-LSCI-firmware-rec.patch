From a782d5018558bb3fffd161f0ac86519239e836d4 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 09:54:06 +0000
Subject: [PATCH 34/55] iio: light: tsl2583: accept a private LSCI firmware
 record

Keep NVMEM authoritative when present. Otherwise allow a firmware-name record so J71t can boot with the existing loader. Apply the same version, record, checksum and arithmetic validation to both sources.
---
 .../bindings/iio/light/tsl2583.yaml           |  5 +++
 drivers/iio/light/tsl2583.c                   | 33 ++++++++++++++-----
 2 files changed, 29 insertions(+), 9 deletions(-)

diff --git a/Documentation/devicetree/bindings/iio/light/tsl2583.yaml b/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
index 988c634b59..91f454010a 100644
--- a/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
+++ b/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
@@ -37,6 +37,10 @@ properties:
   vcc-supply:
     description: Regulator that provides power to the sensor
 
+  firmware-name:
+    description: Private LSCI record from this device, when NVMEM is unavailable.
+    maxItems: 1
+
   nvmem-cells:
     description:
       Apple factory LSCI ambient-light calibration data. Boot firmware must
@@ -68,6 +72,7 @@ allOf:
           - nvmem-cells
     else:
       properties:
+        firmware-name: false
         nvmem-cells: false
         nvmem-cell-names: false
 
diff --git a/drivers/iio/light/tsl2583.c b/drivers/iio/light/tsl2583.c
index e52c574ebf..599885335a 100644
--- a/drivers/iio/light/tsl2583.c
+++ b/drivers/iio/light/tsl2583.c
@@ -9,6 +9,8 @@
 
 #include <linux/kernel.h>
 #include <linux/i2c.h>
+#include <linux/firmware.h>
+#include <linux/property.h>
 #include <linux/errno.h>
 #include <linux/delay.h>
 #include <linux/string.h>
@@ -282,6 +284,8 @@ static int apple_als_load_calibration(struct tsl2583_chip *chip)
 	struct device *dev = &chip->client->dev;
 	struct apple_als_calibration *cal = &chip->cal;
 	struct nvmem_cell *cell;
+	const struct firmware *fw;
+	const char *fw_name;
 	const u8 *record;
 	size_t len;
 	u32 checksum = 0;
@@ -290,15 +294,26 @@ static int apple_als_load_calibration(struct tsl2583_chip *chip)
 	int ret;
 	int i;
 
-	cell = devm_nvmem_cell_get(dev, "calibration");
-	if (IS_ERR(cell))
-		return dev_err_probe(dev, PTR_ERR(cell),
-				     "failed to get LSCI calibration\n");
-
-	data = nvmem_cell_read(cell, &len);
-	if (IS_ERR(data))
-		return dev_err_probe(dev, PTR_ERR(data),
-				     "failed to read LSCI calibration\n");
+	if (!device_property_present(dev, "nvmem-cells") &&
+	    !device_property_read_string(dev, "firmware-name", &fw_name)) {
+		ret = request_firmware(&fw, fw_name, dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to load LSCI file\n");
+		len = fw->size;
+		data = kmemdup(fw->data, len, GFP_KERNEL);
+		release_firmware(fw);
+		if (!data)
+			return -ENOMEM;
+	} else {
+		cell = devm_nvmem_cell_get(dev, "calibration");
+		if (IS_ERR(cell))
+			return dev_err_probe(dev, PTR_ERR(cell),
+					     "failed to get LSCI calibration\n");
+		data = nvmem_cell_read(cell, &len);
+		if (IS_ERR(data))
+			return dev_err_probe(dev, PTR_ERR(data),
+					     "failed to read LSCI calibration\n");
+	}
 
 	if (len < APPLE_ALS_CAL_HEADER_SIZE + info->cal_record_size ||
 	    len & 1 || data[1] != info->cal_version || data[2] != 1 ||
