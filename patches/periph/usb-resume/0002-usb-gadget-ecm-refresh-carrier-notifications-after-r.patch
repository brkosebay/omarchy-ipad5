From 46864bf1264874b31f9eff73dda5f1b529ca013a Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Fri, 23 Oct 2026 23:09:58 +0000
Subject: [PATCH 2/2] usb: gadget: ecm: refresh carrier notifications after
 resume

Do not consume CONNECT or SPEED notification state when usb_ep_queue
rejects a request, including -EAGAIN during USB suspend. Refresh the
connection and speed on resume using the existing single-request state
machine, so the host can recover carrier without rebinding the composite
gadget. The device netdev carrier alone does not report whether the host
received the CDC notification.

Signed-off-by: linux-a9 <linux-a9@localhost>
---
 drivers/usb/gadget/function/f_ecm.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/usb/gadget/function/f_ecm.c b/drivers/usb/gadget/function/f_ecm.c
index e495bac4ef..1f57c6bfbe 100644
--- a/drivers/usb/gadget/function/f_ecm.c
+++ b/drivers/usb/gadget/function/f_ecm.c
@@ -372,6 +372,7 @@ static void ecm_do_notify(struct f_ecm *ecm)
 	struct usb_composite_dev	*cdev = ecm->port.func.config->cdev;
 	__le32				*data;
 	int				status;
+	u8				state = ecm->notify_state;
 
 	/* notification already in flight? */
 	if (atomic_read(&ecm->notify_count))
@@ -417,6 +418,8 @@ static void ecm_do_notify(struct f_ecm *ecm)
 	status = usb_ep_queue(ecm->notify, req, GFP_ATOMIC);
 	if (status < 0) {
 		atomic_dec(&ecm->notify_count);
+		/* A suspended UDC can reject the request with -EAGAIN. */
+		ecm->notify_state = state;
 		DBG(cdev, "notify --> %d\n", status);
 	}
 }
@@ -886,6 +889,8 @@ static void ecm_resume(struct usb_function *f)
 	DBG(cdev, "ECM Resume\n");
 
 	gether_resume(&ecm->port);
+	/* Refresh host carrier, including notifications lost at suspend. */
+	ecm_notify(ecm);
 }
 
 static int ecm_get_status(struct usb_function *f)
