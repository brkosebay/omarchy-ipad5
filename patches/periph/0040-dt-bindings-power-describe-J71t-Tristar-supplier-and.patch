From c20a79c9d48c361aa4e4a4c0067594cafe18f312 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 11:20:40 +0000
Subject: [PATCH 40/55] dt-bindings: power: describe J71t Tristar supplier and
 charging

Describe the J71t-only CBTL1610 presence supplier and require it for the
explicitly armed D2365 charger policy.
---
 .../power/supply/apple,d2365-charger.yaml     | 14 ++-----
 .../supply/apple,j71t-cbtl1610-power.yaml     | 38 +++++++++++++++++++
 2 files changed, 42 insertions(+), 10 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,j71t-cbtl1610-power.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
index 0baacaf0ea..e6a21d3917 100644
--- a/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
@@ -12,6 +12,8 @@ maintainers:
 description: |
   The Apple D2365 PMIC contains power-source status and charger-control banks.
   The J172 variant uses a platform-calibrated, guarded input-current policy.
+  J71t has an explicitly armed policy for a verified USB source, requiring
+  private input-current calibration and live Tristar source presence.
 
 properties:
   compatible:
@@ -42,16 +44,8 @@ required:
 
 allOf:
   - $ref: power-supply.yaml#
-  - if:
-      properties:
-        compatible:
-          const: apple,j71t-d2365-charger
-    then:
-      properties:
-        power-supplies: false
-    else:
-      required:
-        - power-supplies
+  - required:
+      - power-supplies
 
 additionalProperties: false
 
diff --git a/Documentation/devicetree/bindings/power/supply/apple,j71t-cbtl1610-power.yaml b/Documentation/devicetree/bindings/power/supply/apple,j71t-cbtl1610-power.yaml
new file mode 100644
index 0000000000..c9e21f039d
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,j71t-cbtl1610-power.yaml
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,j71t-cbtl1610-power.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple J71t CBTL1610 USB source presence
+
+maintainers:
+  - linux-a9 <linux-a9@localhost>
+
+description: |
+  Read-only VBUS presence for the CBTL1610 revision used by J71t. The driver
+  does not configure accessory routing or determine a source current budget.
+
+properties:
+  compatible:
+    const: apple,j71t-cbtl1610-power
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        power-controller@1a {
+            compatible = "apple,j71t-cbtl1610-power";
+            reg = <0x1a>;
+        };
+    };
