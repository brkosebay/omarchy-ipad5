From 7bc0bc26958b1c6e25b8aa7189a59ee2e624a7cd Mon Sep 17 00:00:00 2001
From: Paul Praschl <maintainer@example.invalid>
Date: Wed, 22 Jul 2026 12:44:43 +0200
Subject: [PATCH 02/55] dt-bindings: w1: add UART HDQ transport

The existing UART 1-Wire master also provides the right subsystem
boundary for UART-generated Texas Instruments HDQ waveforms. Describe an
explicit ti,hdq-uart mode instead of representing the fuel gauge as a
transport-specific serial child.

HDQ mode uses 57600 baud, 8 data bits, no parity and two stop bits. A
serial BREAK supplies the HDQ break pulse, each HDQ bit is encoded as
one UART byte, and the single gauge is represented below the bus without
a 1-Wire ROM ID. The existing w1-uart compatible and its normal 1-Wire
behavior remain unchanged.

Signed-off-by: Paul Praschl <maintainer@example.invalid>
---
 .../devicetree/bindings/w1/w1-uart.yaml       | 22 +++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/w1/w1-uart.yaml b/Documentation/devicetree/bindings/w1/w1-uart.yaml
index bd7c62d780..bdc5691f3b 100644
--- a/Documentation/devicetree/bindings/w1/w1-uart.yaml
+++ b/Documentation/devicetree/bindings/w1/w1-uart.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/w1/w1-uart.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: UART 1-Wire Bus
+title: UART 1-Wire and HDQ Bus
 
 maintainers:
   - Christoph Winklhofer <maintainer@example.invalid>
@@ -25,9 +25,16 @@ description: |
 
   https://www.analog.com/en/technical-articles/using-a-uart-to-implement-a-1wire-bus-master.html
 
+  The UART can alternatively implement the Texas Instruments HDQ protocol.
+  HDQ mode uses 57600 baud, 8 data bits, no parity, two stop bits, and a
+  serial BREAK for the HDQ break pulse. Each HDQ bit is represented by one
+  UART byte, and the bus contains a single device without a 1-Wire ROM ID.
+
 properties:
   compatible:
-    const: w1-uart
+    enum:
+      - w1-uart
+      - ti,hdq-uart
 
   reset-bps:
     default: 9600
@@ -57,3 +64,14 @@ examples:
             compatible = "w1-uart";
         };
     };
+
+  - |
+    serial {
+        onewire {
+            compatible = "ti,hdq-uart";
+
+            fuel-gauge {
+                compatible = "ti,bq27545-hdq";
+            };
+        };
+    };
