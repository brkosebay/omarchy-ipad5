From 16e7486888f771bc9b3c6f571898e259becdf04b Mon Sep 17 00:00:00 2001
From: Paul Praschl <maintainer@example.invalid>
Date: Wed, 19 Aug 2026 14:44:15 +0200
Subject: [PATCH 29/55] dt-bindings: iio: light: Add Apple CT819

The CT819 is the ambient-light sensor Apple uses on the iPad 7. Like the
CT821 it exposes a TSL2581 compatible register interface and carries its
factory calibration in the SysCfg LSCI record, so it shares the compatible
fallback and the paired calibration NVMEM properties.

Signed-off-by: Paul Praschl <maintainer@example.invalid>
---
 .../devicetree/bindings/iio/light/tsl2583.yaml | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/Documentation/devicetree/bindings/iio/light/tsl2583.yaml b/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
index c7b337ca40..988c634b59 100644
--- a/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
+++ b/Documentation/devicetree/bindings/iio/light/tsl2583.yaml
@@ -10,8 +10,8 @@ maintainers:
   - Brian Masney <maintainer@example.invalid>
 
 description: |
-  Ambient light sensing with an i2c interface. Apple CT821 factory
-  calibration is stored in SysCfg. On systems where the SysCfg NVMEM
+  Ambient light sensing with an i2c interface. The Apple CT819 and CT821
+  factory calibration is stored in SysCfg. On systems where the SysCfg NVMEM
   provider is created by boot firmware, the static board tree omits the
   NVMEM link and firmware adds both NVMEM properties before kernel handoff.
 
@@ -23,7 +23,9 @@ properties:
           - amstaos,tsl2581
           - amstaos,tsl2583
       - items:
-          - const: apple,ct821
+          - enum:
+              - apple,ct819
+              - apple,ct821
           - const: amstaos,tsl2581
 
   reg:
@@ -37,9 +39,9 @@ properties:
 
   nvmem-cells:
     description:
-      Apple CT821 factory LSCI ambient-light calibration data. Boot firmware
-      must populate this together with nvmem-cell-names when the provider is
-      not statically representable.
+      Apple factory LSCI ambient-light calibration data. Boot firmware must
+      populate this together with nvmem-cell-names when the provider is not
+      statically representable.
     maxItems: 1
 
   nvmem-cell-names:
@@ -55,7 +57,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: apple,ct821
+            enum:
+              - apple,ct819
+              - apple,ct821
     then:
       dependentRequired:
         nvmem-cells:
