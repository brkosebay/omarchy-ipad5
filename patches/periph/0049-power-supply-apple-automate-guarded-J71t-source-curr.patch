From 1b540ec236e7d3084f7eba7bc6299d6119666998 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 12:23:34 +0000
Subject: [PATCH 49/55] power: supply: apple: automate guarded J71t
 source-current policy

Use observed USB host grants or verified Apple resistor signatures, with
conservative standard USB allowances and private CBAT calibration. Add
bounded D2365 completion polling and exact Tristar route restoration.
Retain battery, VBUS, hardware-cap, timeout, readback and rollback
guards; fault-latch uncertain hardware errors. Export source type and
system scope for desktop consumers.
---
 drivers/power/supply/Kconfig               |   8 +-
 drivers/power/supply/apple_j71t_charger.c  | 165 ++++++--
 drivers/power/supply/apple_tristar_power.c | 429 ++++++++++++++++++++-
 3 files changed, 561 insertions(+), 41 deletions(-)

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index ca721dd7e6..ac82b4705a 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -351,6 +351,7 @@ config APPLE_BELLATRIX_POWER
 config APPLE_D2365_CHARGER
 	tristate "Apple D2365 charger status"
 	depends on MFD_SIMPLE_MFD_I2C
+	depends on USB_GADGET || !USB_GADGET
 	help
 	  Say Y here to enable charger status reporting and the guarded input-current
 	  policy for the Apple D2365 PMIC found in some T8010 devices.
@@ -359,10 +360,11 @@ config APPLE_D2365_CHARGER
 	  safe battery conditions are present, and leaves charge termination to the
 	  PMIC. It does not configure charge current, charge voltage, or interrupts.
 
-	  J71t also provides read-only CBTL1610 VBUS detection and a separately
-	  armed 2400 mA policy for an owner-verified USB source. It requires
+	  J71t also provides CBTL1610 source detection and an automatic
+	  current policy using verified Apple USB host grants and resistor
+	  signatures, with a conservative ordinary USB fallback. It requires
 	  private CBAT calibration and safe battery telemetry, preserves the
-	  handoff settings, and revokes the request on disconnect or error.
+	  handoff settings, and restores them on disconnect, suspend or error.
 
 	  The modules are apple_d2365_charger, apple_j71t_charger and
 	  apple_tristar_power.
