# linux-a9 pcie workstream: options on top of configs/hoolock-16k.config.
# Merged into the tree's .config by scripts/pcie/build.sh on every build and
# checked against build/kernel-pcie/config afterwards: every CONFIG_ line
# here (including "is not set" ones) must appear verbatim in the result.
# Everything is built in: the HoolockRD initramfs carries no modules.
CONFIG_PCIE_APPLE_H9P=y
CONFIG_NVME_PCI_READ_ONLY=y
CONFIG_BLK_DEV_NVME=y
CONFIG_APPLE_DART=y
CONFIG_PCI_MSI=y
# m1n1 phram regions (live ADT, m1n1 log) appear as /dev/mtdN (mtdchar is
# part of MTD core)
CONFIG_MTD=y
CONFIG_MTD_PHRAM=y

# Hang diagnostics, sized so the culprit is on screen within ~60 s:
# hard lockup (buddy CPU watches its neighbour, works without NMIs) after
# 10 s, soft lockup after 20 s, RCU stall after 20 s, hung task and stuck
# workqueue after 30 s. Warn only, never panic, so the other CPU keeps the
# shell alive.
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_WQ_WATCHDOG=y
CONFIG_RCU_CPU_STALL_TIMEOUT=20
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=0
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0

# as in the stock build-kernel.sh: no debug info (disk space)
CONFIG_DEBUG_INFO_NONE=y

# Wi-Fi (round 6): BCM4355 C0 on PCIe port 1 through brcmfmac (PCIe,
# msgbuf), REG_ON on a D2365 PMIC GPIO. Firmware comes from the initramfs
# (scripts/pcie/mkinitramfs-wifi.sh).
CONFIG_GPIO_APPLE_D2365=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
# brcmf_dbg() messages, off unless brcmfmac.debug=<mask> is given
CONFIG_BRCMDBG=y
