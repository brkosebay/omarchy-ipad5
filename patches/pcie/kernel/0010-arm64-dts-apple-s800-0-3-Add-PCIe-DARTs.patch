From 28da4f83e8c52ed4d2b7be93b28f741e955177f6 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 10:07:09 +0000
Subject: [PATCH 10/43] arm64: dts: apple: s800-0-3: Add PCIe DARTs

Add the DARTs in front of PCIe ports 0 (NVMe) and 1 (Wi-Fi), from the
ADT dart-apcie0/1 nodes (dart,s8000). They sit in the per-link power
domains. Disabled by default.

Co-Authored-By: Claude Opus 5.5 <maintainer@example.invalid>
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index fc7dc7c5ba..65482d1f25 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -290,6 +290,26 @@ wdt: watchdog@2102b0000 {
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 4 IRQ_TYPE_LEVEL_HIGH>;
 		};
+
+		pcie0_dart0: iommu@601008000 {
+			compatible = "apple,s8000-dart", "apple,s5l8960x-dart";
+			reg = <0x6 0x01008000 0x0 0x4000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 245 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie_link0>;
+			status = "disabled";
+		};
+
+		pcie0_dart1: iommu@602008000 {
+			compatible = "apple,s8000-dart", "apple,s5l8960x-dart";
+			reg = <0x6 0x02008000 0x0 0x4000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 248 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie_link1>;
+			status = "disabled";
+		};
 	};
 
 	timer {
-- 
2.56.0

