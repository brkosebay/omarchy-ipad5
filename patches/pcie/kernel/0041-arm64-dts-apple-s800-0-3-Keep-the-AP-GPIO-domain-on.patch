From c994b628dda2d38a8f1dd706c602ff19c61a4809 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 15:35:15 +0000
Subject: [PATCH 41/43] arm64: dts: apple: s800-0-3: Keep the AP GPIO domain on

ps_gpio holds the PCIe PERST# lines (and the PCIe ports' links with
them) and the wake buttons. genpd would power it off in the noirq
phase of system sleep, under live links and the wake source. It is
always on at runtime already.
---
 arch/arm64/boot/dts/apple/s800-0-3-pmgr.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3-pmgr.dtsi b/arch/arm64/boot/dts/apple/s800-0-3-pmgr.dtsi
index 196b8e745a..bdae99a4e2 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3-pmgr.dtsi
@@ -82,6 +82,11 @@ ps_gpio: power-controller@80118 {
 		#power-domain-cells = <0>;
 		#reset-cells = <0>;
 		label = "gpio";
+		/*
+		 * Holds the PCIe PERST# lines and the wake buttons: suspend
+		 * must not power it off under live links.
+		 */
+		apple,always-on;
 	};
 
 	ps_pms: power-controller@80120 {
-- 
2.56.0

