From e7a3ee6eb27ef78c123015f03cee7943857803b2 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 13:12:11 +0000
Subject: [PATCH 26/43] nvme-pci: apple-ans: Write-protect the system
 namespaces

The j71t S3E exposes seven namespaces. Only NSID 1 is data (iOS disk0,
the APFS container). The others, read and dumped on the device, hold
what a DFU restore can't bring back or must never be touched:

  2  LLB/iBoot (IMG4)    3  syscfg (factory calibration)
  4  iPCB                5  NVRAM
  6  effaceable storage  7  unused (zeros)

Add a second, independent gate next to CONFIG_NVME_PCI_READ_ONLY. It is
not tied to that option, so it stays when media writes to NSID 1 are
enabled one day:

- I/O queues: anything for NSID 1, only Read/Flush for any other NSID.
- Admin queue: queue management, Identify, Get Log Page, Get Features,
  Abort, AER and Keep Alive; Set Features only controller-wide or for
  NSID 1; Format NVM only for NSID 1. Everything else is refused:
  Sanitize, firmware download/commit, namespace management/attachment,
  security send/receive, directives, self-test and vendor-specific
  commands (Apple's NAND tunnel), all of which can reach every
  namespace.
- Every namespace but NSID 1 is read-only (set_disk_ro) through a new
  optional nvme_ctrl_ops->ns_is_readonly() hook, evaluated wherever
  nvme-core decides a namespace's read-only state.

The command check runs in both places the read-only allowlist does:
nvme_prep_rq() (refusal, logged) and nvme_sq_copy_cmd() (backstop that
neutralizes anything that slipped through), via a new
dma_ops->cmd_allowed() hook.

nvme.apple_ans_unlock_system_namespaces=1 (boot-time only, 0444) lifts
the gate. Never needed for normal use.

The refusal message now also prints the NSID.
---
 drivers/nvme/host/core.c          |  4 +-
 drivers/nvme/host/nvme.h          |  2 +
 drivers/nvme/host/pci-apple-ans.c | 87 +++++++++++++++++++++++++++++++
 drivers/nvme/host/pci-internal.h  |  8 +++
 drivers/nvme/host/pci.c           | 34 ++++++++++--
 5 files changed, 131 insertions(+), 4 deletions(-)

diff --git a/drivers/nvme/host/core.c b/drivers/nvme/host/core.c
index 3598579cfc..ccfec1e14e 100644
--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -2195,7 +2195,9 @@ static bool nvme_update_disk_info(struct nvme_ns *ns, struct nvme_id_ns *id,
 static bool nvme_ns_is_readonly(struct nvme_ns *ns, struct nvme_ns_info *info)
 {
 	return info->is_readonly || test_bit(NVME_NS_FORCE_RO, &ns->flags) ||
-		test_bit(NVME_CTRL_FORCE_RO, &ns->ctrl->flags);
+		test_bit(NVME_CTRL_FORCE_RO, &ns->ctrl->flags) ||
+		(ns->ctrl->ops->ns_is_readonly &&
+		 ns->ctrl->ops->ns_is_readonly(ns->ctrl, ns->head->ns_id));
 }
 
 static inline bool nvme_first_scan(struct gendisk *disk)
diff --git a/drivers/nvme/host/nvme.h b/drivers/nvme/host/nvme.h
index a3d1446eeb..16b2d89895 100644
--- a/drivers/nvme/host/nvme.h
+++ b/drivers/nvme/host/nvme.h
@@ -667,6 +667,8 @@ struct nvme_ctrl_ops {
 	void (*print_device_info)(struct nvme_ctrl *ctrl);
 	bool (*supports_pci_p2pdma)(struct nvme_ctrl *ctrl);
 	unsigned long (*get_virt_boundary)(struct nvme_ctrl *ctrl, bool is_admin);
+	/* Optional: transport-forced read-only namespaces */
+	bool (*ns_is_readonly)(struct nvme_ctrl *ctrl, u32 nsid);
 };
 
 /*
diff --git a/drivers/nvme/host/pci-apple-ans.c b/drivers/nvme/host/pci-apple-ans.c
index bd59ea1083..0a49b5194e 100644
--- a/drivers/nvme/host/pci-apple-ans.c
+++ b/drivers/nvme/host/pci-apple-ans.c
@@ -59,6 +59,18 @@ struct apple_ans_nvme_req {
 	u64 pages[APPLE_ANS_NVMMU_MAX_PAGES];
 };
 
+/*
+ * NSID 1 is the data namespace (iOS disk0: the APFS container). The others
+ * hold factory and boot data a DFU restore can't bring back. On j71t:
+ * 2 LLB/iBoot, 3 syscfg, 4 iPCB, 5 NVRAM, 6 effaceable storage, 7 unused.
+ */
+#define APPLE_ANS_DATA_NSID	1
+
+static bool apple_ans_unlock_system_namespaces;
+module_param(apple_ans_unlock_system_namespaces, bool, 0444);
+MODULE_PARM_DESC(apple_ans_unlock_system_namespaces,
+	"Apple ANS: DANGEROUS. Allow commands that can change namespaces other than NSID 1 (LLB/iBoot, syscfg, NVRAM, effaceable storage) or the whole controller (format/sanitize all, firmware, namespace management, security, vendor commands). Default N; boot-time only.");
+
 static bool apple_ans_dart_hmb;
 module_param(apple_ans_dart_hmb, bool, 0444);
 MODULE_PARM_DESC(apple_ans_dart_hmb,
@@ -180,6 +192,71 @@ bool nvme_pci_apple_ans_match(struct pci_dev *pdev)
 	return np && of_match_node(nvme_pci_apple_ans_hosts, np);
 }
 
+/*
+ * System-namespace guard, on top of (and independent of) the
+ * CONFIG_NVME_PCI_READ_ONLY allowlist. Called for every command at
+ * submission and again when it is copied into the SQ (under the SQ lock).
+ */
+static bool nvme_pci_apple_ans_cmd_allowed(struct nvme_dev *dev, u16 qid,
+					   const struct nvme_command *cmd)
+{
+	u32 nsid = le32_to_cpu(cmd->common.nsid);
+	u8 opcode = cmd->common.opcode;
+	bool ok;
+
+	if (apple_ans_unlock_system_namespaces)
+		return true;
+
+	if (qid) {
+		/* I/O: anything on NSID 1, only reads elsewhere */
+		ok = nsid == APPLE_ANS_DATA_NSID || opcode == nvme_cmd_read ||
+		     opcode == nvme_cmd_flush;
+	} else {
+		switch (opcode) {
+		case nvme_admin_delete_sq:
+		case nvme_admin_create_sq:
+		case nvme_admin_get_log_page:
+		case nvme_admin_delete_cq:
+		case nvme_admin_create_cq:
+		case nvme_admin_identify:
+		case nvme_admin_abort_cmd:
+		case nvme_admin_get_features:
+		case nvme_admin_async_event:
+		case nvme_admin_keep_alive:
+			ok = true;
+			break;
+		case nvme_admin_set_features:
+			/* controller-wide or the data namespace only */
+			ok = nsid == 0 || nsid == APPLE_ANS_DATA_NSID;
+			break;
+		case nvme_admin_format_nvm:
+			ok = nsid == APPLE_ANS_DATA_NSID;
+			break;
+		default:
+			/*
+			 * Sanitize, firmware download/commit, namespace
+			 * management/attachment, security, directives,
+			 * self-test and vendor-specific (Apple NAND tunnel)
+			 * commands can reach every namespace.
+			 */
+			ok = false;
+			break;
+		}
+	}
+
+	if (!ok)
+		dev_err_ratelimited(dev->dev,
+				    "Apple ANS: refused opcode %#x for nsid %u on qid %u: system namespaces are protected\n",
+				    opcode, nsid, qid);
+	return ok;
+}
+
+static bool nvme_pci_apple_ans_ns_readonly(struct nvme_dev *dev, u32 nsid)
+{
+	return !apple_ans_unlock_system_namespaces &&
+	       nsid != APPLE_ANS_DATA_NSID;
+}
+
 static int nvme_pci_apple_ans_init(struct nvme_dev *dev, int node)
 {
 	struct apple_ans_nvme *ans;
@@ -190,6 +267,14 @@ static int nvme_pci_apple_ans_init(struct nvme_dev *dev, int node)
 
 	spin_lock_init(&ans->req_lock);
 	dev->dma_data = ans;
+
+	if (apple_ans_unlock_system_namespaces)
+		dev_warn(dev->dev,
+			 "Apple ANS: system namespaces UNLOCKED (nvme.apple_ans_unlock_system_namespaces=1)\n");
+	else
+		dev_info(dev->dev,
+			 "Apple ANS: namespaces other than NSID %u are read-only and only safe admin commands are sent\n",
+			 APPLE_ANS_DATA_NSID);
 	return 0;
 }
 
@@ -912,6 +997,8 @@ const struct nvme_pci_dma_ops nvme_pci_apple_ans_ops = {
 	.prepare_enable = nvme_pci_apple_ans_prepare_enable,
 	.write_cc	= nvme_pci_apple_ans_write_cc,
 	.read_csts	= nvme_pci_apple_ans_read_csts,
+	.cmd_allowed	= nvme_pci_apple_ans_cmd_allowed,
+	.ns_readonly	= nvme_pci_apple_ans_ns_readonly,
 	.map_data	= nvme_pci_apple_ans_map_data,
 	.unmap_data	= nvme_pci_apple_ans_unmap_data,
 	.queue_depth	= nvme_pci_apple_ans_queue_depth,
diff --git a/drivers/nvme/host/pci-internal.h b/drivers/nvme/host/pci-internal.h
index 8cce5fb69e..71c4dd3c3b 100644
--- a/drivers/nvme/host/pci-internal.h
+++ b/drivers/nvme/host/pci-internal.h
@@ -40,6 +40,14 @@ struct nvme_pci_dma_ops {
 	/* Optional: replace the CC write and the CSTS read (bring-up checks) */
 	int (*write_cc)(struct nvme_dev *dev, u32 cc);
 	int (*read_csts)(struct nvme_dev *dev, u32 *csts);
+	/*
+	 * Optional, independent of CONFIG_NVME_PCI_READ_ONLY: refuse commands
+	 * (called under the SQ lock, must not sleep) and force namespaces
+	 * read-only.
+	 */
+	bool (*cmd_allowed)(struct nvme_dev *dev, u16 qid,
+			    const struct nvme_command *cmd);
+	bool (*ns_readonly)(struct nvme_dev *dev, u32 nsid);
 	blk_status_t (*map_data)(struct request *req);
 	bool (*unmap_data)(struct request *req);
 	u32 (*queue_depth)(struct nvme_dev *dev, u32 depth);
diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index fd40525a09..dc45a347a8 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -601,8 +601,8 @@ static inline void nvme_write_sq_db(struct nvme_queue *nvmeq, bool write_sq)
  * management, security send, directives, vendor-specific opcodes, saved
  * features) is refused before it reaches the submission queue.
  */
-static bool nvme_pci_cmd_allowed(const struct nvme_queue *nvmeq,
-				 const struct nvme_command *cmd)
+static bool nvme_pci_ro_cmd_allowed(const struct nvme_queue *nvmeq,
+				    const struct nvme_command *cmd)
 {
 	u32 cdw10;
 
@@ -655,6 +655,24 @@ static bool nvme_pci_cmd_allowed(const struct nvme_queue *nvmeq,
 	}
 }
 
+/*
+ * Both gates: the CONFIG_NVME_PCI_READ_ONLY allowlist above and the
+ * device's own policy (Apple ANS: protected system namespaces), which
+ * holds even without CONFIG_NVME_PCI_READ_ONLY.
+ */
+static bool nvme_pci_cmd_allowed(const struct nvme_queue *nvmeq,
+				 const struct nvme_command *cmd)
+{
+	const struct nvme_pci_dma_ops *ops = nvmeq->dev->dma_ops;
+
+	if (!nvme_pci_ro_cmd_allowed(nvmeq, cmd))
+		return false;
+	if (ops && ops->cmd_allowed &&
+	    !ops->cmd_allowed(nvmeq->dev, nvmeq->qid, cmd))
+		return false;
+	return true;
+}
+
 static inline void nvme_sq_copy_cmd(struct nvme_queue *nvmeq,
 				    struct nvme_command *cmd)
 	__must_hold(&nvmeq->sq_lock)
@@ -1373,8 +1391,9 @@ static blk_status_t nvme_prep_rq(struct request *req)
 	if (unlikely(!nvme_pci_cmd_allowed(req->mq_hctx->driver_data,
 					   &iod->cmd))) {
 		dev_err_ratelimited(nvme_req(req)->ctrl->device,
-				    "read-only: refused opcode %#x on %s queue\n",
+				    "read-only: refused opcode %#x nsid %u on %s queue\n",
 				    iod->cmd.common.opcode,
+				    le32_to_cpu(iod->cmd.common.nsid),
 				    nvme_req(req)->ctrl->admin_q == req->q ?
 				    "admin" : "I/O");
 		ret = BLK_STS_IOERR;
@@ -3517,6 +3536,14 @@ static int nvme_pci_reg_write32(struct nvme_ctrl *ctrl, u32 off, u32 val)
 	return 0;
 }
 
+static bool nvme_pci_ns_is_readonly(struct nvme_ctrl *ctrl, u32 nsid)
+{
+	struct nvme_dev *dev = to_nvme_dev(ctrl);
+
+	return dev->dma_ops && dev->dma_ops->ns_readonly &&
+	       dev->dma_ops->ns_readonly(dev, nsid);
+}
+
 static int nvme_pci_reg_read64(struct nvme_ctrl *ctrl, u32 off, u64 *val)
 {
 	*val = lo_hi_readq(to_nvme_dev(ctrl)->bar + off);
@@ -3574,6 +3601,7 @@ static const struct nvme_ctrl_ops nvme_pci_ctrl_ops = {
 	.print_device_info	= nvme_pci_print_device_info,
 	.supports_pci_p2pdma	= nvme_pci_supports_pci_p2pdma,
 	.get_virt_boundary	= nvme_pci_get_virt_boundary,
+	.ns_is_readonly		= nvme_pci_ns_is_readonly,
 };
 
 static int nvme_dev_map(struct nvme_dev *dev)
-- 
