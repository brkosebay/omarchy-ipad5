+/**
+ * usb_gadget_current_source_detached - forget accounting on measured VBUS loss
+ * @node: supplying controller node
+ *
+ * Sleepable; called only for a physical detach, never for USB link PM/reset.
+ * Does not disconnect or unbind the gadget and performs no controller I/O.
+ */
+void usb_gadget_current_source_detached(const struct device_node *node)
+{
+	struct usb_udc *udc;
+	unsigned long flags;
+
+	mutex_lock(&udc_lock);
+	list_for_each_entry(udc, &udc_list, list) {
+		struct usb_gadget *gadget = udc->gadget;
+
+		if (!gadget->current_budget_enabled ||
+		    dev_of_node(gadget->dev.parent) != node)
+			continue;
+		spin_lock_irqsave(&gadget->state_lock, flags);
+		gadget->current_extra_ma = 0;
+		gadget->current_host_grant = false;
+		gadget->current_base_ma = 0;
+		gadget->current_configured = false;
+		gadget->current_bus_connected = false;
+		gadget->current_suspended = false;
+		spin_unlock_irqrestore(&gadget->state_lock, flags);
+		gadget_current_notify(gadget);
+	}
+	mutex_unlock(&udc_lock);
+}
+EXPORT_SYMBOL_GPL(usb_gadget_current_source_detached);
