From 2fa6392a4d5ac46ed643cdba256b7c93a4e3e135 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Tue, 27 Oct 2026 15:31:46 +0000
Subject: [PATCH 1/3] dt-bindings: power: d2365: describe generic USB host
 policy

Use the board input ceiling for USB host sources and drop the development
unit's probe-time owner override property. Explicit userspace requests
remain per-attach caps in the driver.

Signed-off-by: linux-a9 <linux-a9@localhost>
---
 .../bindings/power/supply/apple,d2365-charger.yaml        | 8 +-------
 1 file changed, 1 insertion(+), 7 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
index 59aee44205..d0460b8419 100644
--- a/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/apple,d2365-charger.yaml
@@ -12,7 +12,7 @@ maintainers:
 description: |
   The Apple D2365 PMIC contains power-source status and charger-control banks.
   The J172 variant uses a platform-calibrated, guarded input-current policy.
-  J71t has an explicitly armed policy for a verified USB source, requiring
+  J71t uses the board ceiling for a USB host source, requiring
   private input-current calibration and live Tristar source presence.
 
 properties:
@@ -42,12 +42,6 @@ properties:
     enum: [500000, 1000000, 2100000, 2400000]
     default: 500000
 
-  apple,owner-input-limit-microamp:
-    description: |
-      Owner-authorized input ceiling for this development unit's USB host.
-      Requires an enumerated host or a detected brick and valid CBAT codes;
-      the board ceiling still applies. Omission leaves source-based policy.
-    enum: [500000, 1000000, 2100000, 2400000]
 
 required:
   - compatible
