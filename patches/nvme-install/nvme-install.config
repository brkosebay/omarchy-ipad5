# linux-a9 nvme-install workstream: options on top of configs/hoolock-16k.config
# and patches/pcie/pcie.config (which pins CONFIG_NVME_PCI_READ_ONLY=y).
#
# Compiles in the boot parameter nvme.write_window=NSID:FIRST-LAST (patch
# 0001). Without that parameter the NVMe disk stays exactly as read-only as
# before; with it, only NVMe Write inside the window is added
# (docs/nvme-install/DESIGN.md, "Kernel").
CONFIG_NVME_PCI_READ_ONLY=y
CONFIG_NVME_PCI_WRITE_WINDOW=y
