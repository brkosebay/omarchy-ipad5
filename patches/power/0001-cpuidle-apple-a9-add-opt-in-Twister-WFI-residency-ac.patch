From f12b3d7157fde4afbdbb36c6b1d912c9f5f7c9a9 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 21:14:51 +0000
Subject: [PATCH 1/3] cpuidle: apple-a9: add opt-in Twister WFI residency
 accounting

---
 drivers/cpuidle/Kconfig.arm        |  7 ++++
 drivers/cpuidle/Makefile           |  2 ++
 drivers/cpuidle/cpuidle-apple-a9.c | 55 ++++++++++++++++++++++++++++++
 3 files changed, 64 insertions(+)
 create mode 100644 drivers/cpuidle/cpuidle-apple-a9.c

diff --git a/drivers/cpuidle/Kconfig.arm b/drivers/cpuidle/Kconfig.arm
index b88b01aa58..d6b0b83d73 100644
--- a/drivers/cpuidle/Kconfig.arm
+++ b/drivers/cpuidle/Kconfig.arm
@@ -130,3 +130,10 @@ config ARM_QCOM_SPM_CPUIDLE
 	  The Subsystem Power Manager (SPM) controls low power modes for the
 	  CPU and L2 cores. It interface with various system drivers to put
 	  the cores in low power modes.
+
+config ARM_APPLE_A9_CPUIDLE
+	bool "Apple A9 WFI accounting driver"
+	depends on ARM64 && ARCH_APPLE
+	help
+	  Register a WFI-only driver on Twister CPUs when booted with
+	  cpuidle_apple_a9.enable=1. Default off; no deep idle support.
diff --git a/drivers/cpuidle/Makefile b/drivers/cpuidle/Makefile
index 88cbc2a7ae..6105f36356 100644
--- a/drivers/cpuidle/Makefile
+++ b/drivers/cpuidle/Makefile
@@ -46,3 +46,5 @@ obj-$(CONFIG_RISCV_SBI_CPUIDLE)		+= cpuidle-riscv-sbi.o
 ###############################################################################
 # S390 drivers
 obj-$(CONFIG_S390_CPUIDLE)		+= cpuidle-s390.o
+
+obj-$(CONFIG_ARM_APPLE_A9_CPUIDLE) += cpuidle-apple-a9.o
diff --git a/drivers/cpuidle/cpuidle-apple-a9.c b/drivers/cpuidle/cpuidle-apple-a9.c
new file mode 100644
index 0000000000..91f4e0e589
--- /dev/null
+++ b/drivers/cpuidle/cpuidle-apple-a9.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Apple Twister WFI accounting. No PSCI or unverified retention protocol. */
+#include <linux/cpuidle.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <asm/cpuidle.h>
+
+static bool enable;
+module_param(enable, bool, 0444);
+MODULE_PARM_DESC(enable, "Register Twister WFI accounting (default: off)");
+
+static int __cpuidle a9_enter_wfi(struct cpuidle_device *dev,
+				struct cpuidle_driver *drv, int index)
+{
+	cpu_do_idle();
+	return index;
+}
+
+static struct cpuidle_driver a9_idle_driver = {
+	.name = "apple_a9_wfi",
+	.owner = THIS_MODULE,
+	.states[0] = {
+		.enter = a9_enter_wfi,
+		.enter_s2idle = a9_enter_wfi,
+		.exit_latency = 1,
+		.target_residency = 1,
+		.power_usage = UINT_MAX,
+		.name = "WFI",
+		.desc = "WFI with existing boot firmware configuration",
+	},
+	.safe_state_index = 0,
+	.state_count = 1,
+};
+
+static int __init a9_idle_init(void)
+{
+	struct device_node *cpu;
+
+	if (!enable || !(of_machine_is_compatible("apple,s8000") ||
+			 of_machine_is_compatible("apple,s8003")))
+		return -ENODEV;
+	for_each_of_cpu_node(cpu) {
+		if (!of_device_is_compatible(cpu, "apple,twister")) {
+			of_node_put(cpu);
+			return -ENODEV;
+		}
+	}
+	/* Deliberately do not change CYC_OVRD or advertise a deep state. */
+	return cpuidle_register(&a9_idle_driver, NULL);
+}
+
+device_initcall(a9_idle_init);
+MODULE_DESCRIPTION("Apple A9 WFI residency accounting");
+MODULE_LICENSE("GPL");
-- 
2.56.0

