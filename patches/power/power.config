CONFIG_CPU_IDLE=y
CONFIG_ARM_APPLE_A9_CPUIDLE=y
# Read-only DVFS observer (docs/power/overclock.md); runs only with apple_a9_dvfs_ro.enable=1
CONFIG_APPLE_A9_DVFS_RO=y
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_APPLE_S8003_THERMAL=y
CONFIG_APPLE_A9_TUNING=y
CONFIG_WATCHDOG=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
# Critical trips must have a bounded fallback if orderly poweroff stalls.
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=5000
