From 47a949be4f52211410a19dd519de6cc3af79c1d1 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Sat, 24 Oct 2026 01:53:39 +0000
Subject: [PATCH 4/4] backlight: apple-dwi: replay J71t block init at probe and
 resume

Map the complete S8000 DWI block and replay the five boot writes
recovered from AppleS8000DWI. Keep legacy channel-only DTs usable,
preserve the boot brightness across initialization and wait at most 1 ms
for each transaction. The parent resumes before the backlight core
restores brightness.

Signed-off-by: linux-a9 <linux-a9@localhost>
---
 arch/arm64/boot/dts/apple/s800-0-3.dtsi |  4 +-
 drivers/video/backlight/apple_dwi_bl.c  | 89 ++++++++++++++++++++++---
 2 files changed, 83 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800-0-3.dtsi b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
index 807f221961b7fe301f095e9264ecab04325d34c1..e394cb81d8ced019617701ddb8ec6c536e77e40a 100644
--- a/arch/arm64/boot/dts/apple/s800-0-3.dtsi
+++ b/arch/arm64/boot/dts/apple/s800-0-3.dtsi
@@ -209,9 +209,9 @@ aic: interrupt-controller@20e100000 {
 			power-domains = <&ps_aic>;
 		};
 
-		dwi_bl: backlight@20e200080 {
+		dwi_bl: backlight@20e200000 {
 			compatible = "apple,s8000-dwi-bl", "apple,dwi-bl";
-			reg = <0x2 0x0e200080 0x0 0x8>;
+			reg = <0x2 0x0e200000 0x0 0x4000>;
 			power-domains = <&ps_dwi>;
 			status = "disabled";
 		};
diff --git a/drivers/video/backlight/apple_dwi_bl.c b/drivers/video/backlight/apple_dwi_bl.c
index 93bd744972d60adcb564c91908f7d81d057d5c3c..0422e396cdb93b13500e4ed34285f265a22f5e9a 100644
--- a/drivers/video/backlight/apple_dwi_bl.c
+++ b/drivers/video/backlight/apple_dwi_bl.c
@@ -9,7 +9,11 @@
 #include <linux/bitfield.h>
 #include <linux/device.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pm.h>
 #include <linux/platform_device.h>
 
 #define DWI_BL_CTL			0x0
@@ -34,24 +38,64 @@
 #define DWI_BL_MAX_BRIGHTNESS		2047
 
 struct apple_dwi_bl {
+	struct device *dev;
 	void __iomem *base;
+	void __iomem *block;
+	/* Serialize block initialization and brightness transactions. */
+	struct mutex lock;
 };
 
+static int dwi_bl_wait(struct apple_dwi_bl *dwi_bl)
+{
+	u32 value;
+	int ret;
+
+	ret = readl_poll_timeout(dwi_bl->base + DWI_BL_CTL, value,
+				 !(value & DWI_BL_CTL_SEND1), 10, 1000);
+	if (ret)
+		dev_err_ratelimited(dwi_bl->dev, "DWI busy timeout: %#x\n", value);
+	return ret;
+}
+
+/* AppleS8000DWI::start(), J71t nclk=1, polarity=1, STR=8000, lockout=5. */
+static int dwi_bl_init(struct apple_dwi_bl *dwi_bl)
+{
+	int ret;
+
+	if (!dwi_bl->block)
+		return 0;
+
+	mutex_lock(&dwi_bl->lock);
+	writel(0x00000001, dwi_bl->block + 0x00);
+	writel(0x0002ee00, dwi_bl->block + 0xd0);
+	writel(0x00000078, dwi_bl->block + 0x04);
+	writel(0, dwi_bl->block + 0x84);
+	writel(0x41, dwi_bl->block + 0x80);
+	ret = dwi_bl_wait(dwi_bl);
+	mutex_unlock(&dwi_bl->lock);
+	if (!ret)
+		dev_info(dwi_bl->dev, "DWI block initialized (1 ms transaction bound)\n");
+	return ret;
+}
+
 static int dwi_bl_update_status(struct backlight_device *bl)
 {
 	struct apple_dwi_bl *dwi_bl = bl_get_data(bl);
-
 	int brightness = backlight_get_brightness(bl);
-
 	u32 cmd = 0;
+	int ret;
 
 	cmd |= FIELD_PREP(DWI_BL_CMD_DATA, brightness);
 	cmd |= FIELD_PREP(DWI_BL_CMD_TYPE, DWI_BL_CMD_TYPE_SET_BRIGHTNESS);
 
-	writel(cmd, dwi_bl->base + DWI_BL_CMD);
-	writel(DWI_BL_CTL_SEND, dwi_bl->base + DWI_BL_CTL);
-
-	return 0;
+	mutex_lock(&dwi_bl->lock);
+	ret = dwi_bl_wait(dwi_bl);
+	if (!ret) {
+		writel(cmd, dwi_bl->base + DWI_BL_CMD);
+		writel(DWI_BL_CTL_SEND, dwi_bl->base + DWI_BL_CTL);
+	}
+	mutex_unlock(&dwi_bl->lock);
+	return ret;
 }
 
 static int dwi_bl_get_brightness(struct backlight_device *bl)
@@ -75,6 +119,7 @@ static int dwi_bl_probe(struct platform_device *dev)
 	struct backlight_device *bl;
 	struct backlight_properties props;
 	struct resource *res;
+	int brightness, ret;
 
 	dwi_bl = devm_kzalloc(&dev->dev, sizeof(*dwi_bl), GFP_KERNEL);
 	if (!dwi_bl)
@@ -84,6 +129,25 @@ static int dwi_bl_probe(struct platform_device *dev)
 	if (IS_ERR(dwi_bl->base))
 		return PTR_ERR(dwi_bl->base);
 
+	dwi_bl->dev = &dev->dev;
+	mutex_init(&dwi_bl->lock);
+	if (of_device_is_compatible(dev->dev.of_node, "apple,s8000-dwi-bl")) {
+		if (resource_size(res) >= 0xd4) {
+			/* The recovered boot words are specific to this board. */
+			if (of_machine_is_compatible("apple,j71t"))
+				dwi_bl->block = dwi_bl->base;
+			dwi_bl->base += 0x80;
+		} else {
+			dev_warn(&dev->dev, "legacy DWI window: block resume init unavailable\n");
+		}
+	}
+	/* Preserve the boot brightness before the init transaction clears DATA. */
+	brightness = FIELD_GET(DWI_BL_CMD_DATA,
+			       readl(dwi_bl->base + DWI_BL_CMD));
+	ret = dwi_bl_init(dwi_bl);
+	if (ret)
+		return ret;
+
 	memset(&props, 0, sizeof(struct backlight_properties));
 	props.type = BACKLIGHT_PLATFORM;
 	props.max_brightness = DWI_BL_MAX_BRIGHTNESS;
@@ -96,11 +160,19 @@ static int dwi_bl_probe(struct platform_device *dev)
 
 	platform_set_drvdata(dev, dwi_bl);
 
-	bl->props.brightness = dwi_bl_get_brightness(bl);
+	bl->props.brightness = brightness;
 
-	return 0;
+	return backlight_update_status(bl);
 }
 
+/* The backlight class child restores brightness after this parent resumes. */
+static int dwi_bl_resume(struct device *dev)
+{
+	return dwi_bl_init(dev_get_drvdata(dev));
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(dwi_bl_pm_ops, NULL, dwi_bl_resume);
+
 static const struct of_device_id dwi_bl_of_match[] = {
 	{ .compatible = "apple,dwi-bl" },
 	{},
@@ -111,6 +183,7 @@ MODULE_DEVICE_TABLE(of, dwi_bl_of_match);
 static struct platform_driver dwi_bl_driver = {
 	.driver		= {
 		.name	= "apple-dwi-bl",
+		.pm = pm_sleep_ptr(&dwi_bl_pm_ops),
 		.of_match_table = dwi_bl_of_match
 	},
 	.probe		= dwi_bl_probe,
