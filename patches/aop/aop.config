# A9 AOP observer + active driver (a9/aop). Built in, inert at runtime:
# apple_a9_aop.debug=1 enables the read-only register capture and debugfs,
# apple_a9_aop.attach=1 the attach preflight, apple_a9_aop.active=1 boots
# the AOP and registers the IIO accelerometer. See docs/periph/aop-sensors.md.
CONFIG_DEBUG_FS=y
CONFIG_IIO=y
CONFIG_APPLE_A9_AOP=y
CONFIG_APPLE_A9_AOP_IIO=y
CONFIG_APPLE_A9_AOP_ACTIVE=y
