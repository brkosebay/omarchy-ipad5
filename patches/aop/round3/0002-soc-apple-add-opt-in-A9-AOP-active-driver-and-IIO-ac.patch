+	AFK_WAIT_INIT,	/* STARTEP sent, waiting 0x80 */
+	AFK_INIT,	/* 0xa0 sent, collecting buffers/rings */
+	AFK_STARTING,	/* 0xa3 sent */
+	AFK_RUNNING,	/* 0x86 received */
+	AFK_STOPPING,	/* 0xa4 sent */
+	AFK_STOPPED,	/* 0x87/0xc3 received */
+	AFK_FAILED,
+};
