+MODULE_FIRMWARE(AOP_EXT_FW);
+MODULE_FIRMWARE(AOP_CAL_FW);
+MODULE_DESCRIPTION("Apple J71t AOP active driver (RTBuddy, SPU/AFK, accelerometer)");
+MODULE_LICENSE("GPL");
