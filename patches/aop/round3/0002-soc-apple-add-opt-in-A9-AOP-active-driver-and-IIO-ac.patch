+	void __iomem *wrapper;
+	void __iomem *region;
+	void __iomem *autoboot;
+	resource_size_t region_pa;
+	resource_size_t region_size;
+	resource_size_t wrapper_pa;
+	u32 chip_id, chip_revision, runtime_size;
+	void *ext;
+	dma_addr_t ext_dma;
+	size_t ext_size;
+	struct device_node *domains[AOP_DOMAINS];
+	u32 aop_target;
+	int irq;
