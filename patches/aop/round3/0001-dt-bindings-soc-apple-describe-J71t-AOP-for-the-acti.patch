From 1a0464202ba185bcfcef1c89eb8a2ea39eb0861d Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Fri, 23 Oct 2026 15:29:29 +0000
Subject: [PATCH 1/2] dt-bindings: soc: apple: describe J71t AOP for the active
 driver

Experimental, board-specific binding for the J71t always-on processor:
IOP wrapper, AOP target region (live ADT region-size 0x9b000), auto-boot
register, outbox/inbox interrupts, the five PMGR domains that are only
observed (never attached as power-domains), and the values the firmware
tag table needs (aop-target, chip-id, chip-revision). An optional
mount-matrix carries the measured residual screen matrix.

Co-Authored-By: Claude Opus 5.5 <maintainer@example.invalid>
---
 .../bindings/soc/apple/apple,j71t-aop.yaml    | 79 +++++++++++++++++++
 1 file changed, 79 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/apple/apple,j71t-aop.yaml

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,j71t-aop.yaml b/Documentation/devicetree/bindings/soc/apple/apple,j71t-aop.yaml
new file mode 100644
index 0000000000..c31c4f911d
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/apple/apple,j71t-aop.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/apple/apple,j71t-aop.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple J71t always-on processor (AOP), experimental active driver
+
+maintainers:
+  - Berkay Kosebay <brkosebay@users.noreply.github.com>
+
+description: |
+  A7IOPV2 coprocessor running RTBuddy firmware with SPU/AFK services
+  (accelerometer, gyro, compass, pressure). Experimental and board specific;
+  the driver also requires the apple_a9_aop.active=1 boot parameter. The
+  PMGR domains are only observed: the AOP domain is always-on and holds its
+  parents, so no power-domains consumer is described.
+
+properties:
+  compatible:
+    const: apple,j71t-aop
+
+  reg:
+    items:
+      - description: IOP wrapper (CPU control, remap, mailbox)
+      - description: AOP target memory region (ADT region-base/region-size)
+      - description: Auto-boot control register
+
+  reg-names:
+    items:
+      - const: wrapper
+      - const: region
+      - const: auto-boot
+
+  interrupts:
+    items:
+      - description: Outbox not empty (IOP to AP)
+      - description: Inbox space (AP to IOP)
+
+  interrupt-names:
+    items:
+      - const: rx
+      - const: tx
+
+  apple,observe-domains:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 5
+    maxItems: 5
+    description: |
+      PMGR nodes AOP_GPIO, AOP, AOP_BUSIF, AOP_CPU, AOP_FILTER. Checked
+      to be on before any access; never attached as power-domains.
+
+  apple,aop-target:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: ADT iop-aop-nub aop-target, written to the firmware AOPt tag.
+
+  apple,chip-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: SoC chip id (/chosen chip-id), written to the SOC_ tag.
+
+  apple,chip-revision:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: SoC revision (/arm-io chip-revision), written to the SOCR tag.
+
+  mount-matrix:
+    description: Residual screen matrix after the firmware applied ARot.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - apple,observe-domains
+  - apple,aop-target
+  - apple,chip-id
+  - apple,chip-revision
+
+additionalProperties: false
-- 
