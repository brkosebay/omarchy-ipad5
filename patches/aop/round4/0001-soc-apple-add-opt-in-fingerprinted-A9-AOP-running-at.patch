@@ -304,6 +318,7 @@ static void a9_aop_trace(struct a9_aop *aop, char dir, u64 word, int status)
 	t->word = word;
 	t->dir = dir;
 	t->status = status;
+	t->phase = READ_ONCE(aop->phase);
 	if (apple_a9_aop_debug())
 		dev_dbg(aop->dev, "%c %016llx %d\n", dir, word, status);
 }
@@ -349,6 +364,8 @@ static int a9_aop_send(struct a9_aop *aop, u8 ep, u64 payload)
 	ret = a9_aop_pack(ep, payload, &wire);
 	if (ret)
