 drivers/soc/apple/a9-aop.h                |   3 +
 drivers/soc/apple/apple-a9-aop-active.c   | 373 ++++++++++++++++++++--
 drivers/soc/apple/apple-a9-aop.c          |   7 +-
 7 files changed, 675 insertions(+), 27 deletions(-)
