new file mode 100644
index 0000000000..0bfe54c5fc
--- /dev/null
+++ b/drivers/soc/apple/a9-aop-iio.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _A9_AOP_IIO_H
+#define _A9_AOP_IIO_H
+
+#include <linux/types.h>
+
+struct device;
+struct iio_dev;
+struct a9_spu_subpacket;
+
+/* Future negotiated SPU core calls these, never the passive observer.
+ * Each verification bit represents evidence, not a user bypass parameter.
+ */
+struct a9_aop_accel_config {
+	const u8 *arot;
+	size_t arot_size;
+	bool arot_layout_verified;
+	bool scale_verified;
+	bool calibration_verified;
+	bool firmware_applied_arot;
+	/* When firmware already applied ARot, require a measured residual
+	 * screen matrix. Otherwise the verified ARot matrix is exposed in IIO.
+	 */
+	const s8 *residual_matrix;
+	u32 report_interval_us;
+	bool interval_units_verified;
+	const struct a9_spu_subpacket *first_report;
+};
+
+struct iio_dev *a9_aop_accel_register(struct device *parent,
+				      const struct a9_aop_accel_config *config);
+int a9_aop_accel_report(struct iio_dev *indio_dev,
+			const struct a9_spu_subpacket *sub);
+void a9_aop_accel_invalidate(struct iio_dev *indio_dev);
+
+#endif
diff --git a/drivers/soc/apple/a9-aop-protocol.h b/drivers/soc/apple/a9-aop-protocol.h
new file mode 100644
index 0000000000..029cf4b130
--- /dev/null
+++ b/drivers/soc/apple/a9-aop-protocol.h
@@ -0,0 +1,231 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Old A7IOPV2 / SPU v8, NOT the contemporary 96-bit ASC transport. */
+#ifndef _A9_AOP_PROTOCOL_H
+#define _A9_AOP_PROTOCOL_H
+
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#define A9_AOP_PAYLOAD_MASK 0x00ffffffffffffffULL
+#define A9_SPU_OUTER_SIZE 16
+#define A9_SPU_SUBHEADER_SIZE 24
+#define A9_SPU_ACCEL_REPORT 0xc2
+#define A9_SPU_NOTIFY 0x10
+#define A9_SPU_REPLY 0x20
+
+struct a9_spu_subpacket {
+	u8 category;
+	u16 subtype;
+	u16 tag;
+	u64 timestamp;
+	const u8 *payload;
+	u32 size;
+};
+
+struct a9_aop_motion {
+	u16 sequence;
+	u32 status;
+	s32 axes[3];
+};
+
+static inline int a9_aop_pack(u8 endpoint, u64 payload, u64 *wire)
+{
+	if (payload & ~A9_AOP_PAYLOAD_MASK)
+		return -ERANGE;
+	*wire = ((u64)endpoint << 56) | payload;
+	return 0;
+}
+
+static inline u8 a9_aop_endpoint(u64 wire)
+{
+	return wire >> 56;
+}
+
+static inline u64 a9_aop_payload(u64 wire)
+{
+	return wire & A9_AOP_PAYLOAD_MASK;
+}
+
+static inline int a9_aop_hello_reply(u64 wire, u64 *reply)
+{
+	u64 payload = a9_aop_payload(wire);
+	u16 min = payload & 0xffff, max = (payload >> 16) & 0xffff;
+
+	if (a9_aop_endpoint(wire) || ((payload >> 52) & 15) != 1 ||
+	    min > 12 || max < 12)
+		return -EPROTONOSUPPORT;
+	*reply = 0x00200000000c000cULL;
+	return 0;
+}
+
+/* Descriptor units are 64 bytes. No address translation is implied. */
+static inline int a9_spu_queue_descriptor(u64 wire, size_t backing_size,
+					  u16 *tag, size_t *offset, size_t *size)
+{
+	u64 payload = a9_aop_payload(wire);
+	u8 type = payload >> 48;
+
+	if (type < 0x8a || type > 0x8c)
+		return -EPROTO;
+	*tag = payload & 0xffff;
+	*size = ((payload >> 16) & 0xffff) * 64;
+	*offset = ((payload >> 32) & 0xffff) * 64;
+	if (!*size || *offset > backing_size || *size > backing_size - *offset)
+		return -EMSGSIZE;
+	return 0;
+}
+
+/* Returns 1 per subpacket, 0 at end, negative on malformed input. Callers
+ * validate the complete outer packet before dispatching any subpacket.
+ * Ring/channel envelopes must already have been removed by the transport.
+ */
+static inline int a9_spu_next(const u8 *packet, size_t length, size_t *cursor,
+			      struct a9_spu_subpacket *sub)
+{
+	const u8 *p;
+	u32 size;
+
+	if (length < A9_SPU_OUTER_SIZE || packet[0] != 2 ||
+	    *cursor < A9_SPU_OUTER_SIZE || *cursor > length)
+		return -EPROTO;
+	if (*cursor == length)
+		return 0;
+	if (length - *cursor < A9_SPU_SUBHEADER_SIZE)
+		return -EMSGSIZE;
+	p = packet + *cursor;
+	size = get_unaligned_le32(p);
+	if (p[4] != 2)
+		return -EPROTO;
+	if (size > length - *cursor - A9_SPU_SUBHEADER_SIZE)
+		return -EMSGSIZE;
+	sub->category = p[5];
+	sub->subtype = get_unaligned_le16(p + 6);
+	sub->tag = get_unaligned_le16(p + 8);
+	sub->timestamp = get_unaligned_le64(p + 10);
+	sub->size = size;
+	sub->payload = p + A9_SPU_SUBHEADER_SIZE;
+	*cursor += A9_SPU_SUBHEADER_SIZE + size;
+	return 1;
+}
+
+static inline int a9_spu_motion(const struct a9_spu_subpacket *sub,
+				struct a9_aop_motion *motion)
+{
+	if (sub->category >= 0x10 || sub->subtype != A9_SPU_ACCEL_REPORT)
+		return -EPROTO;
+	if (sub->size < 22)
+		return -EMSGSIZE;
+	motion->sequence = get_unaligned_le16(sub->payload);
+	motion->status = get_unaligned_le32(sub->payload + 2);
+	motion->axes[0] = (s32)get_unaligned_le32(sub->payload + 6);
+	motion->axes[1] = (s32)get_unaligned_le32(sub->payload + 10);
+	motion->axes[2] = (s32)get_unaligned_le32(sub->payload + 14);
+	return 0;
+}
+
+static inline int a9_spu_announcement(const struct a9_spu_subpacket *sub,
+				      char name[33], u32 *service_id)
+{
+	if (sub->category >= 0x10 || sub->subtype != 0xc0)
+		return -EPROTO;
+	if (sub->size < 40)
+		return -EMSGSIZE;
+	memcpy(name, sub->payload, 32);
+	name[32] = 0;
+	*service_id = get_unaligned_le32(sub->payload + 32);
+	return 0;
+}
+
+/* The value below is the property PAYLOAD only. Channel/ring framing,
+ * category=notify, subtype=4 and a unique transaction tag are added by the
+ * negotiated transport; wait for a correlated IOReturn before proceeding.
+ * Stream sequence: batch(0x16), raw(0x5c), report(0); report=0 stops.
+ */
+static inline void a9_spu_property32(u8 payload[12], u32 key, u32 value)
+{
+	put_unaligned_le32(0, payload);
+	put_unaligned_le32(key, payload + 4);
+	put_unaligned_le32(value, payload + 8);
+}
+
+/* Complete subtype4 notify subpacket, excluding the outer and queue headers.
+ * Timestamp is zero for AP commands; capacity follows the iOS builder (0xe4).
+ */
+static inline void a9_spu_property_notify(u8 packet[36], u16 tag, u32 key, u32 value)
+{
+	memset(packet, 0, 36);
+	put_unaligned_le32(12, packet);
+	packet[4] = 2;
+	packet[5] = A9_SPU_NOTIFY;
+	put_unaligned_le16(4, packet + 6);
+	put_unaligned_le16(tag, packet + 8);
+	put_unaligned_le32(0xe4, packet + 20);
+	a9_spu_property32(packet + 24, key, value);
+}
+
+static inline int a9_spu_property_reply(const struct a9_spu_subpacket *sub, u16 tag)
+{
+	if (sub->category != A9_SPU_REPLY || sub->subtype != 4 || sub->tag != tag)
+		return -EPROTO;
+	if (sub->size < 4)
+		return -EMSGSIZE;
+	return get_unaligned_le32(sub->payload) ? -EREMOTEIO : 0;
+}
+
+/* Build a stream plan, not traffic. The caller must measure interval units
+ * and supported rates, wait for EACH correlated reply, and stop on failure.
+ * Disabled plan is only report_interval=0; no raw/batch changes are invented.
+ */
+static inline int a9_spu_stream_plan(u8 payloads[3][12], bool units_verified,
+				     u32 batch, u32 raw, u32 report)
+{
+	if (!report) {
+		a9_spu_property32(payloads[0], 0, 0);
+		return 1;
+	}
+	if (!units_verified)
+		return -EOPNOTSUPP;
+	a9_spu_property32(payloads[0], 0x16, batch);
+	a9_spu_property32(payloads[1], 0x5c, raw);
+	a9_spu_property32(payloads[2], 0, report);
+	return 3;
+}
+
+/* Candidate ARot v1 layout. The caller MUST establish this layout from
+ * firmware arithmetic or six-pose evidence before using the result in IIO.
+ * No version word is treated as a coefficient, and padding must be zero.
+ */
+static inline int a9_aop_arot_v1(const u8 *blob, size_t length, s8 matrix[9])
+{
+	unsigned int row, col, nonzero;
+
+	if (length != 16 || get_unaligned_le32(blob) != 1)
+		return -EINVAL;
+	for (row = 0; row < 3; row++) {
+		nonzero = 0;
+		if (blob[4 + row * 4 + 3])
+			return -EINVAL;
+		for (col = 0; col < 3; col++) {
+			s8 value = (s8)blob[4 + row * 4 + col];
+
+			if (value < -1 || value > 1)
+				return -EINVAL;
+			matrix[row * 3 + col] = value;
+			nonzero += value != 0;
+		}
+		if (nonzero != 1)
+			return -EINVAL;
+	}
+	for (col = 0; col < 3; col++) {
+		nonzero = 0;
+		for (row = 0; row < 3; row++)
+			nonzero += matrix[row * 3 + col] != 0;
+		if (nonzero != 1)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+#endif
diff --git a/drivers/soc/apple/apple-a9-aop.c b/drivers/soc/apple/apple-a9-aop.c
new file mode 100644
index 0000000000..bc3b47cb8b
--- /dev/null
+++ b/drivers/soc/apple/apple-a9-aop.c
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* J71t AOP passive bring-up. Deliberately no FIFO, IRQ, reset or write path. */
+#include <linux/debugfs.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/seq_file.h>
+#include <linux/soc/apple/pmgr-observe.h>
+
+#define AOP_REGS 5
+#define AOP_DOMAINS 5
+#define AOP_MAIN_FW "apple/aop/ipad6faop-20H350.bin"
+#define AOP_EXT_FW "apple/aop/ipad6faop_ext-20H350.bin"
+
+static bool debug;
+module_param(debug, bool, 0400);
+MODULE_PARM_DESC(debug, "Enable read-only J71t AOP debugfs (default off)");
+static bool attach;
+module_param(attach, bool, 0400);
+MODULE_PARM_DESC(attach, "Enable attach preflight only; hardware attach is blocked (default off)");
+
+static const char * const reg_names[AOP_REGS] = {
+	"cpu_control", "cpu_running", "inbox_control", "outbox_control", "idle_status",
+};
+
+static const resource_size_t reg_addresses[AOP_REGS] = {
+	0x210800044, 0x210800b88, 0x210804008, 0x210804020, 0x210804040,
+};
+
+/* Child -> parent lock order matches s800-0-3-pmgr.dtsi. */
+static const char * const domain_names[AOP_DOMAINS] = {
+	"aop_gpio", "aop", "aop_busif", "aop_cpu", "aop_filter",
+};
+
+struct a9_aop {
+	struct device *dev;
+	void __iomem *regs[AOP_REGS];
+	struct device_node *domains[AOP_DOMAINS];
+};
+
+struct a9_aop_snapshot {
+	struct a9_aop *aop;
+	u32 values[AOP_REGS];
+};
+
+static void a9_aop_read_status(void *data)
+{
+	struct a9_aop_snapshot *snapshot = data;
+	unsigned int i;
+
+	for (i = 0; i < AOP_REGS; i++)
+		snapshot->values[i] = readl(snapshot->aop->regs[i]);
+}
+
+static int a9_aop_status_show(struct seq_file *s, void *unused)
+{
+	struct a9_aop *aop = s->private;
+	struct apple_pmgr_observation states[AOP_DOMAINS];
+	struct a9_aop_snapshot snapshot = { .aop = aop };
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < AOP_DOMAINS; i++) {
+		states[i].raw = 0;
+		states[i].genpd_status = -1;
+	}
+	seq_printf(s, "format=1 boottime_ns=%llu hardware_writes=none\n", ktime_get_boottime_ns());
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_read_status, &snapshot);
+	for (i = 0; i < AOP_DOMAINS; i++)
+		seq_printf(s, "domain=%s genpd=%d raw=0x%08x actual=%u target=%u auto=%u\n",
+			   domain_names[i], states[i].genpd_status, states[i].raw,
+			   (states[i].raw >> 4) & 15, states[i].raw & 15,
+			   !!(states[i].raw & BIT(28)));
+	seq_printf(s, "snapshot_errno=%d\n", ret);
+	if (ret) {
+		seq_puts(s, "wrapper=skipped reason=domain-off-transition-reset-or-unavailable\n");
+		return 0;
+	}
+	for (i = 0; i < AOP_REGS; i++)
+		seq_printf(s, "%s address=0x%llx value=0x%08x\n", reg_names[i],
+			   (unsigned long long)reg_addresses[i], snapshot.values[i]);
+	seq_printf(s, "cpu_running_bit=%u\n", snapshot.values[1] & 1);
+	seq_printf(s, "inbox_faults=%u outbox_faults=%u\n",
+		   (snapshot.values[2] >> 18) & 3, (snapshot.values[3] >> 18) & 3);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(a9_aop_status);
+
+static int a9_aop_preflight_show(struct seq_file *s, void *unused)
+{
+	struct a9_aop *aop = s->private;
+	struct apple_pmgr_observation states[AOP_DOMAINS] = {};
+	struct a9_aop_snapshot snapshot = { .aop = aop };
+	const struct firmware *fw;
+	static const char * const names[] = { AOP_MAIN_FW, AOP_EXT_FW };
+	static const size_t sizes[] = { 342336, 37024 };
+	unsigned int i;
+	int ret;
+
+	seq_puts(s, "hardware_writes=none fifo_reads=none irqs=none dma=none\n");
+	if (!attach) {
+		seq_puts(s, "result=disabled enable=apple_a9_aop.attach=1\n");
+		return 0;
+	}
+	ret = apple_pmgr_observe(aop->domains, AOP_DOMAINS, states,
+				 a9_aop_read_status, &snapshot);
+	if (ret) {
+		seq_printf(s, "result=blocked-domain-state errno=%d\n", ret);
+		return 0;
+	}
+	if ((snapshot.values[2] | snapshot.values[3]) & GENMASK(19, 18)) {
+		seq_puts(s, "result=blocked-mailbox-fault action=no-fifo-no-ack-no-reset\n");
+		return 0;
+	}
+	if (snapshot.values[1] & 1) {
+		seq_puts(s, "case=running result=blocked-retained-memory-and-host-ownership\n");
+		seq_puts(s, "action=retain-firmware-no-hello-no-fifo-no-reset\n");
+		return 0;
+	}
+	seq_puts(s, "case=stopped\n");
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		ret = request_firmware_direct(&fw, names[i], aop->dev);
+		if (ret) {
+			seq_printf(s, "firmware=%s errno=%d result=blocked-firmware\n",
+				   names[i], ret);
+			return 0;
+		}
+		seq_printf(s, "firmware=%s size=%zu expected=%zu\n",
+			   names[i], fw->size, sizes[i]);
+		ret = fw->size == sizes[i] ? 0 : -EINVAL;
+		release_firmware(fw);
+		if (ret) {
+			seq_puts(s, "result=blocked-firmware-size\n");
+			return 0;
+		}
+	}
+	seq_puts(s, "result=blocked-memory-reservation-remap-and-patchbay\n");
+	seq_puts(s, "action=no-load-no-cpu-release-no-mailbox\n");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(a9_aop_preflight);
+
+static void a9_aop_put_node(void *node)
+{
+	of_node_put(node);
+}
+
+static void a9_aop_remove_debugfs(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
+static int a9_aop_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct a9_aop *aop;
+	struct dentry *dir;
+	struct resource *res;
+	const char *label;
+	unsigned int i;
+	int ret;
+
+	/* No resource requests or MMIO on the ordinary boot path. */
+	if (!debug || !of_machine_is_compatible("apple,j71t"))
+		return -ENODEV;
+	if (of_find_property(dev->of_node, "power-domains", NULL) ||
+	    platform_get_resource(pdev, IORESOURCE_MEM, AOP_REGS))
+		return -EINVAL;
+	aop = devm_kzalloc(dev, sizeof(*aop), GFP_KERNEL);
+	if (!aop)
+		return -ENOMEM;
+	aop->dev = dev;
+	for (i = 0; i < AOP_REGS; i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res || res->start != reg_addresses[i] || resource_size(res) != 4)
+			return -EINVAL;
+		aop->regs[i] = devm_ioremap_resource(dev, res);
+		if (IS_ERR(aop->regs[i]))
+			return PTR_ERR(aop->regs[i]);
+	}
+	if (of_count_phandle_with_args(dev->of_node, "apple,observe-domains", NULL) != AOP_DOMAINS)
+		return -EINVAL;
+	for (i = 0; i < AOP_DOMAINS; i++) {
+		aop->domains[i] = of_parse_phandle(dev->of_node, "apple,observe-domains", i);
+		if (!aop->domains[i])
+			return -EINVAL;
+		ret = devm_add_action_or_reset(dev, a9_aop_put_node, aop->domains[i]);
+		if (ret)
+			return ret;
+		if (of_property_read_string(aop->domains[i], "label", &label) ||
+		    strcmp(label, domain_names[i]))
+			return -EINVAL;
+	}
+	/* Remove debugfs before devres releases the maps and private data. */
+	dir = debugfs_create_dir("apple-a9-aop", NULL);
+	if (IS_ERR(dir))
+		return PTR_ERR(dir);
+	ret = devm_add_action_or_reset(dev, a9_aop_remove_debugfs, dir);
+	if (ret)
+		return ret;
+	debugfs_create_file("status", 0400, dir, aop, &a9_aop_status_fops);
+	debugfs_create_file("preflight", 0400, dir, aop, &a9_aop_preflight_fops);
+	dev_info(dev, "read-only debugfs ready; attach preflight %s; no power consumer\n",
+		 attach ? "enabled" : "disabled");
+	return 0;
+}
+
+static const struct of_device_id a9_aop_match[] = {
+	{ .compatible = "apple,j71t-aop-observer" },
+	{}
+};
+
+static struct platform_driver a9_aop_driver = {
+	.probe = a9_aop_probe,
+	.driver = {
+		.name = "apple-a9-aop",
+		.of_match_table = a9_aop_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(a9_aop_driver);
+
+MODULE_FIRMWARE(AOP_MAIN_FW);
+MODULE_FIRMWARE(AOP_EXT_FW);
+MODULE_DESCRIPTION("Apple J71t AOP read-only bring-up observer");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/soc/apple/pmgr-observe.h b/include/linux/soc/apple/pmgr-observe.h
new file mode 100644
index 0000000000..477b7fa223
--- /dev/null
+++ b/include/linux/soc/apple/pmgr-observe.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SOC_APPLE_PMGR_OBSERVE_H
+#define _LINUX_SOC_APPLE_PMGR_OBSERVE_H
+
+#include <linux/types.h>
+
+struct device_node;
+
+struct apple_pmgr_observation {
+	u32 raw;
+	int genpd_status;
+};
+
+/*
+ * Diagnostic only. Nodes must be in child-before-parent lock order, with no
+ * duplicates (maximum five). Takes no power/runtime-PM reference. read() must
+ * not sleep or acquire genpd locks; it runs with IRQs disabled and all domain
+ * locks held, only if every genpd and hardware actual/target state is ON and
+ * reset/disable/parent-off are clear. Hardware auto-PM remains untouched and is
+ * recorded in raw; locks exclude software transitions, not autonomous gating.
+ * -EHOSTDOWN means read() was skipped.
+ */
+int apple_pmgr_observe(struct device_node **nodes, unsigned int count,
+		       struct apple_pmgr_observation *states,
+		       void (*read)(void *), void *data);
+
+#endif
