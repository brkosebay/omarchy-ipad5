Subject: [PATCH 1/2] dt-bindings: soc: apple: describe J71t passive AOP
 observer

---
 .../soc/apple/apple,j71t-aop-observer.yaml    | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/apple/apple,j71t-aop-observer.yaml

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,j71t-aop-observer.yaml b/Documentation/devicetree/bindings/soc/apple/apple,j71t-aop-observer.yaml
new file mode 100644
index 0000000000..082c49ea22
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/apple/apple,j71t-aop-observer.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/apple/apple,j71t-aop-observer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple J71t AOP passive diagnostic observer
+
+maintainers:
+  - Berkay Kosebay <brkosebay@users.noreply.github.com>
+
+description: |
+  Experimental bring-up node, specific to the S8003 J71t board. Only the five
+  side-effect-free 32-bit status/control reads established from AppleA7IOPV2
+  are described. No power consumer, interrupt, FIFO, reset or firmware-memory
+  resource belongs in this node. This is not a binding for a functional AOP.
+
+properties:
+  compatible:
+    const: apple,j71t-aop-observer
+
+  reg:
+    items:
+      - description: CPU control at wrapper offset 0x44
+      - description: CPU running at wrapper offset 0xb88
+      - description: Inbox control at wrapper offset 0x4008
+      - description: Outbox control at wrapper offset 0x4020
+      - description: Idle status at wrapper offset 0x4040
+
+  reg-names:
+    items:
+      - const: cpu-control
+      - const: cpu-running
+      - const: inbox-control
+      - const: outbox-control
+      - const: idle-status
+
+  apple,observe-domains:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 5
+    maxItems: 5
+    description: |
+      PMGR nodes in lock order AOP_GPIO, AOP, AOP_BUSIF, AOP_CPU, AOP_FILTER.
+      These phandles only identify providers for read-only observation;
+      they are not power-domains and do not attach/resume a consumer.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - apple,observe-domains
+
+additionalProperties: false
-- 
