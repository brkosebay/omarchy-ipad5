+static void rr_free(void *data)
+{
+	struct a9_ring_reader *rr = data;
+
+	bitmap_free(rr->read_pages);
+	bitmap_free(rr->skip_pages);
+	kfree(rr->snapshot);
+	kfree(rr->page);
+	kfree(rr);
