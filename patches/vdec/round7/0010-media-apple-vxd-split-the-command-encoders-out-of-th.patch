-
-void apple_vxd_cmd_group_close(struct apple_vxd_cmdbuf *cb)
-{
-	if (!cb->group_open)
-		cb->error = true;
-	cb->group_open = false;
-	cb->run_hdr = SIZE_MAX;
-}
