-	if (bytes & ~VXD_CMD_LOAD_MAX) {
-		cb->error = true;
-		return;
-	}
-	if (!vxd_cmd_begin(cb, 3))
-		return;
-	vxd_cmd_put(cb, VXD_CMD_TABLE_XFER | bytes);
-	vxd_cmd_put(cb, va);
-	vxd_cmd_put(cb, dst);
-}
