+unsigned int apple_vxd_mbox_drain(struct apple_vxd_dev *vxd)
+{
+	unsigned int count = 0;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vxd->mbox_lock, flags);
+	if (vxd->mbox_ready)
+		count = vxd_mbox_drain_locked(vxd);
+	spin_unlock_irqrestore(&vxd->mbox_lock, flags);
