+		vxd->stats.malformed++;
+		dev_err_ratelimited(vxd->dev,
+				    "TO_HOST message %#010x at %u claims %u words (%u queued); dropping the queue\n",
+				    msg[0], rd, n, vxd_ring_dist(rd, wr, cap));
