 static void apple_vxd_reset_fmt(struct apple_vxd_ctx *ctx,
 				struct v4l2_format *f, u32 fourcc)
 {
@@ -71,11 +87,12 @@ static bool apple_vxd_is_valid_fmt(struct apple_vxd_ctx *ctx, u32 fourcc,
