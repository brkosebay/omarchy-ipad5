 6 files changed, 677 insertions(+), 133 deletions(-)

diff --git a/drivers/media/platform/apple/vxd/apple-vxd-core.c b/drivers/media/platform/apple/vxd/apple-vxd-core.c
index 026a301d70aca31b1715d0bc607fa72ac4b8a64f..2780baeb9b0c7827faa3284801a9eaa72d0ba881 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-core.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-core.c
@@ -52,16 +52,62 @@ static bool apple_vxd_debug;
 module_param_named(debug, apple_vxd_debug, bool, 0444);
 MODULE_PARM_DESC(debug, "log register details beyond probe summary");
 
+/*
+ * Round 2's oops was in the first open() of the freshly exposed video
+ * node (udev's v4l_id).  apple_vxd.v4l2=0 skips the V4L2 registration
+ * entirely so the probe/GART/boot rungs can be worked on without any
+ * /dev/video* or /dev/media* node existing.  Read once, at probe.
+ */
+static bool apple_vxd_v4l2_param = true;
+module_param_named(v4l2, apple_vxd_v4l2_param, bool, 0444);
+MODULE_PARM_DESC(v4l2, "register the V4L2 m2m/media devices (0 = probe only)");
+
+/*
+ * Per-ioctl/per-job STEP lines (vxd_step_io).  On by default for the
+ * bring-up rounds so a crash in any V4L2 handler names it; a decode run or
+ * v4l2-compliance produces hundreds of them, so they can be switched off
+ * at runtime through /sys/module/apple_vxd/parameters/step_ioctls.
+ */
+static bool apple_vxd_step_ioctls = true;
+module_param_named(step_ioctls, apple_vxd_step_ioctls, bool, 0644);
+MODULE_PARM_DESC(step_ioctls,
+		 "announce every V4L2 ioctl/job with a flushed STEP line (default on)");
+
+static void vxd_vstep(const struct device *dev, const char *fmt, va_list args)
+{
+	struct va_format vaf = { .fmt = fmt, .va = &args };
+
+	dev_emerg(dev, "STEP %pV\n", &vaf);
+	pr_flush(100, false);
+}
+
 /*
  * Crash reporting for the bring-up rounds: announce the next step BEFORE
  * doing it and flush the console, so the last line on the screen or in
  * netconsole (or the pstore panic record) names the step that faulted.
  * Round 1's rebind panic left nothing behind; this removes the ambiguity.
+ * Process context only (pr_flush may sleep).
  */
-void vxd_step(const struct device *dev, const char *what)
+void vxd_step(const struct device *dev, const char *fmt, ...)
 {
-	dev_emerg(dev, "STEP %s\n", what);
-	pr_flush(100, false);
+	va_list args;
+
+	va_start(args, fmt);
+	vxd_vstep(dev, fmt, args);
+	va_end(args);
+}
+
+/* Same, for the high-rate V4L2 entry points (gated by step_ioctls). */
+void vxd_step_io(const struct device *dev, const char *fmt, ...)
+{
+	va_list args;
+
+	if (!READ_ONCE(apple_vxd_step_ioctls))
+		return;
+
+	va_start(args, fmt);
+	vxd_vstep(dev, fmt, args);
+	va_end(args);
 }
 
 /*
@@ -103,7 +149,7 @@ void apple_vxd_watchdog(struct work_struct *work)
  * history fields of the genpd backing this device so a boot that touches
  * a half-powered block is identifiable from the log.
  */
-static void apple_vxd_log_pwrstate(struct apple_vxd_dev *vxd, const char *when)
+void apple_vxd_log_pwrstate(struct apple_vxd_dev *vxd, const char *when)
 {
 	struct device_node *domain, *parent;
 	struct regmap *pmgr;
@@ -367,15 +413,33 @@ static int apple_vxd_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_disable_runtime_pm;
 
-	/* Debugfs (dumps + the boot trigger) first so a later step can be
-	 * re-run or inspected no matter how far probe got.
+	/*
+	 * Codec registration fills vxd->coded_fmts before any V4L2 node can
+	 * exist; apple_vxd_v4l2_init() refuses to register without it.
 	 */
-	apple_vxd_mbox_init(vxd);
-
-	ret = apple_vxd_v4l2_init(vxd);
+	ret = apple_vxd_h264_register(vxd);
 	if (ret)
 		goto err_gart_fini;
 
+	/*
+	 * Debugfs (dumps + the boot trigger) first so a later step can be
+	 * re-run or inspected no matter how far probe got.  Nothing after
+	 * this point fails the probe: an error return here would free vxd
+	 * (devm) under the live debugfs files.
+	 */
+	apple_vxd_mbox_init(vxd);
+
+	if (apple_vxd_v4l2_param) {
+		ret = apple_vxd_v4l2_init(vxd);
+		if (ret)
+			dev_err(&pdev->dev,
+				"V4L2 registration failed (%d); continuing without /dev/video (debugfs boot trigger still usable)\n",
+				ret);
+	} else {
+		dev_info(&pdev->dev,
+			 "v4l2: registration skipped (apple_vxd.v4l2=0)\n");
+	}
+
 	if (apple_vxd_boot_firmware_param) {
 		ret = apple_vxd_boot_firmware(vxd);
 		if (ret)
@@ -429,7 +493,7 @@ static struct platform_driver apple_vxd_driver = {
 	.probe = apple_vxd_probe,
 	.remove = apple_vxd_remove,
 	.driver = {
-		.name = "apple-vxd",
+		.name = APPLE_VXD_DRV_NAME,
 		.pm = &apple_vxd_pm_ops,
 		.of_match_table = apple_vxd_of_match,
 	},
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-fw.c b/drivers/media/platform/apple/vxd/apple-vxd-fw.c
index 32603f836287a52a77d2c9df64bbd4f32857603b..63ff4502f5c091d4aa32c7c574295901a4dddc8e 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-fw.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-fw.c
@@ -185,12 +185,16 @@ static int vxd_known_state_v2(struct apple_vxd_dev *vxd)
  */
 static void vxd_discover_core(struct apple_vxd_dev *vxd)
 {
-	u32 saved, pipe, status = 0, maxa = 0;
+	u32 pipe, status = 0, maxa = 0;
 
 	vxd->cfg_flags = ((vxd->num_entropy_pipes != 0) << 21);
 
-	/* save 0x440, set the firmware clock value [E] */
-	saved = vxd_read(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE);
+	/*
+	 * save 0x440, set the firmware clock value [E].  The saved value is
+	 * not restored in this prologue (round 2 already left it unused), so
+	 * only the read is kept, in the kext's order.
+	 */
+	vxd_read(vxd, VXD_REG_CR_PVDEC_MAN_CLK_ENABLE);
 	vxd_set_clocks(vxd, VXD_CLK_ENABLE_FW);
 
 	for (pipe = 1; pipe <= vxd->num_pixel_pipes; pipe++) {
@@ -394,6 +398,8 @@ int apple_vxd_boot_firmware(struct apple_vxd_dev *vxd)
 
 	memcpy(vxd->fw_vaddr, fw->data, fw->size);
 	release_firmware(fw);
+	/* Every later failure unwinds through out_release: no double free. */
+	fw = NULL;
 
 	/* PrepareCore [E], in the kext's order. */
 	ret = vxd_known_state_v1(vxd, "PrepareCore");
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-h264.c b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
index eacde4be6ef0af78a4cce1cf0cf401ab62afb581..5fbfa366a9de198677e2dcc3d7ce4c2b0e40c618 100644
--- a/drivers/media/platform/apple/vxd/apple-vxd-h264.c
+++ b/drivers/media/platform/apple/vxd/apple-vxd-h264.c
@@ -20,15 +20,28 @@ static int apple_vxd_h264_validate_sps(struct apple_vxd_ctx *ctx,
 {
 	const struct apple_vxd_dev *vxd = ctx->vxd;
 
+	/*
+	 * Reject the profiles whose tools the 8-bit 4:2:0 decoder lacks;
+	 * High 10/4:2:2/4:4:4 are caught by the chroma/bit-depth checks below.
+	 * No allow-list: the control's default (profile_idc 0, before
+	 * userspace sets an SPS) must pass, or TRY_EXT_CTRLS on the current
+	 * values fails (v4l2-compliance, round 3 QEMU smoke).
+	 */
 	switch (sps->profile_idc) {
-	case 66: /* constrained baseline / baseline */
-	case 77: /* main */
-	case 100: /* high */
-		break;
-	default:
+	case 88: /* extended: data partitioning */
+	case 83: /* scalable baseline */
+	case 86: /* scalable high */
+	case 118: /* multiview high */
+	case 128: /* stereo high */
+	case 134: /* MFC high */
+	case 135: /* MFC depth high */
+	case 138: /* multiview depth high */
+	case 139: /* enhanced multiview depth high */
 		dev_dbg(vxd->dev, "sps: unsupported profile %u\n",
 			sps->profile_idc);
 		return -EINVAL;
+	default:
+		break;
 	}
 
 	if (sps->chroma_format_idc > 1) {
@@ -199,6 +212,18 @@ static const struct apple_vxd_coded_fmt_desc apple_vxd_h264_fmt = {
 	.decoded_fmts = apple_vxd_h264_decoded_fmts,
 };
 
-const struct apple_vxd_coded_fmt_desc apple_vxd_coded_fmts[] = {
+static const struct apple_vxd_coded_fmt_desc apple_vxd_coded_fmts[] = {
 	apple_vxd_h264_fmt,
 };
+
+/*
+ * Fills the device's coded-format table.  Called during probe, before any
+ * V4L2 node exists: apple_vxd_v4l2_init() and open() both refuse to run
+ * without it (round 2 had no such fill and oopsed in the first open()).
+ */
+int apple_vxd_h264_register(struct apple_vxd_dev *vxd)
+{
+	vxd->coded_fmts = apple_vxd_coded_fmts;
+	vxd->num_coded_fmts = ARRAY_SIZE(apple_vxd_coded_fmts);
+	return 0;
+}
diff --git a/drivers/media/platform/apple/vxd/apple-vxd-mbox.c b/drivers/media/platform/apple/vxd/apple-vxd-mbox.c
