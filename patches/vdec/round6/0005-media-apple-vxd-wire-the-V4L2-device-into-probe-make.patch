 		return dev_err_probe(&pdev->dev, PTR_ERR(vxd->regs),
@@ -266,6 +354,7 @@ static int apple_vxd_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	vxd_step(&pdev->dev, "probe: enable runtime PM");
 	pm_runtime_set_autosuspend_delay(&pdev->dev, 100);
 	pm_runtime_use_autosuspend(&pdev->dev);
 	pm_runtime_enable(&pdev->dev);
@@ -278,6 +367,15 @@ static int apple_vxd_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_disable_runtime_pm;
 
+	/* Debugfs (dumps + the boot trigger) first so a later step can be
