+
+/*
+ * RefPicList0 per P slice as DPB slots: the default list (8.2.4.2.1),
+ * truncated to num_ref_idx_l0_active, then the slice's modifications
+ * (8.2.4.3).  Entries past the available references are NO_REF.
+ */
+static int apple_vxd_h264_ref_lists(struct apple_vxd_h264_ctx *h,
+				    unsigned int nslices,
+				    const struct v4l2_ctrl_h264_sps *sps,
+				    const struct v4l2_ctrl_h264_decode_params *dp)
+{
+	struct v4l2_h264_reference plist[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference list[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reflist_builder b;
+	bool built = false;
+	unsigned int i, k;
+	int ret;
+
+	for (i = 0; i < nslices; i++) {
+		const struct apple_vxd_h264_slice *sl = &h->slices[i];
+		unsigned int len = sl->num_ref_idx_l0_active_minus1 + 1;
+
+		memset(h->ref_slots[i], APPLE_VXD_H264_NO_REF,
+		       sizeof(h->ref_slots[i]));
+		if (sl->slice_type != V4L2_H264_SLICE_TYPE_P)
+			continue;
+
+		if (!built) {
+			v4l2_h264_init_reflist_builder(&b, dp, sps, dp->dpb);
+			v4l2_h264_build_p_ref_list(&b, plist);
+			built = true;
+		}
+		for (k = 0; k < V4L2_H264_REF_LIST_LEN; k++) {
+			list[k] = plist[k];
+			if (k >= b.num_valid)
+				list[k].index = APPLE_VXD_H264_NO_REF;
+		}
+		ret = apple_vxd_h264_modify_ref_list(sl, 0, sps, dp, list, len);
+		if (ret)
+			return ret;
+		for (k = 0; k < len; k++)
+			h->ref_slots[i][0][k] = list[k].index;
+	}
+	return 0;
+}
