# Apple A9 "VXD" video decoder (a9/vdec, round 3). V4L2 stateless H.264
# bring-up: probe (R0) always runs; the DEVA firmware boot (R1) is behind:
#   apple_vxd.boot_firmware=1   kernel cmdline at probe (the normal path)
#   echo 1 > /sys/kernel/debug/apple-vxd/boot   runtime trigger
#   apple_vxd.va_offset=0x...   fetch-address/aperture-base candidate
#   apple_vxd.debug=1           register dumps in dmesg
#   apple_vxd.v4l2=0            skip the V4L2 nodes entirely (probe only)
#   apple_vxd.step_ioctls=0     silence per-ioctl/job STEP lines (also
#                               /sys/module/apple_vxd/parameters/step_ioctls)
# See docs/periph/vdec-test-plan.md.
CONFIG_DEBUG_FS=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_APPLE_VXD=y
