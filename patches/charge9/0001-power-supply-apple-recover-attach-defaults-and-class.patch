-		if (cc < 0) {
-			ret = cc;
-			goto fail;
+		cc_ua = -1;
+		/* Ignore one unsettled first reading; require two equal advertisements. */
+		for (attempt = 0; attempt < 3; attempt++) {
+			cc = apple_tristar_pin_mv(ts, false, false, true);
+			ts->cc_mv = cc;
+			if (!attempt)
+				ts->cc_first_mv = cc;
+			if (cc < 0) {
