 	ts->error = error;
 	ts->online = online;
@@ -747,8 +815,18 @@ static int apple_tristar_usb_event(struct notifier_block *nb, unsigned long even
 	if (budget->of_node != ts->usb_node || READ_ONCE(ts->stopping) ||
 	    READ_ONCE(ts->sleeping))
