+/* IOAccessoryPowerSourceItemUSB_TypeC_Current, 5de4024, inclusive edges. */
+static int apple_tristar_cc_current(int mv)
+{
+	if (mv < 0 || mv > 4000)
+		return -ERANGE;
+	return mv > 1229 ? 3000000 : mv > 659 ? 1500000 : 0;
+}
