+static ssize_t cs42l81_jack_write(struct file *f, const char __user *ubuf,
+				  size_t len, loff_t *ppos)
+{
+	struct cs42l81 *cs = ((struct seq_file *)f->private_data)->private;
+	char buf[16] = {}, *cmd;
