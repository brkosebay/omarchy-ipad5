+	if (!strcmp(cmd, "1") || !strcmp(cmd, "plug"))
+		forced = 1;
+	else if (!strcmp(cmd, "0") || !strcmp(cmd, "unplug"))
+		forced = 0;
+	else if (!strcmp(cmd, "auto"))
