 sound/soc/apple/Makefile    |   2 +
 sound/soc/apple/s8000-mca.c | 778 ++++++++++++++++++++++++++++++++++++
 3 files changed, 791 insertions(+)
 create mode 100644 sound/soc/apple/s8000-mca.c

