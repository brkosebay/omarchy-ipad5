# linux-a9 audio workstream (J71t speakers): merged on top of hoolock-16k.config
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_APPLE_S8000_MCA=y
CONFIG_SND_SOC_CS42L81=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_DMADEVICES=y
# SmartIO coprocessor + DMA (MCA0 TX endpoint 0x28)
CONFIG_APPLE_SIO=y
CONFIG_APPLE_SIO_DMA=y
CONFIG_SPI_SPIDEV=y
CONFIG_DEBUG_FS=y
