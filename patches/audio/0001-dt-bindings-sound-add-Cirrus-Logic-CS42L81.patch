From 519401b6dd21640ebb84b8b269b418d58cf7a7dc Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 11:46:06 +0000
Subject: [PATCH 01/17] dt-bindings: sound: add Cirrus Logic CS42L81

Apple-specific Cirrus codec with integrated speaker drivers, controlled
over SPI. Used on the A9 iPad 5 (J71t) for the built-in speakers.

Co-Authored-By: Claude Opus 5.5 <maintainer@example.invalid>
---
 .../bindings/sound/cirrus,cs42l81.yaml        | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml

diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml
new file mode 100644
index 0000000000..a496011d54
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs42l81.yaml
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs42l81.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS42L81 audio codec (Apple)
+
+maintainers:
+  - linux-a9 <linux-a9@localhost>
+
+description:
+  Apple-specific Cirrus Logic codec with integrated speaker drivers, used on
+  the A9 iPad 5. Controlled over SPI with a 5-byte paged register protocol.
+
+allOf:
+  - $ref: dai-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs42l81
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: mclk
+
+  mute-gpios:
+    maxItems: 1
+    description: Speaker mute line, asserted while the speakers are muted.
+
+  apple,max-speaker-gain-db-q8:
+    $ref: /schemas/types.yaml#/definitions/int32
+    description: Maximum speaker gain in 1/256 dB (ADT spkr-gain-db).
+
+  apple,speaker-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [1, 2]
+    description: Number of speaker outputs in use.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      audio-codec@0 {
+        compatible = "cirrus,cs42l81";
+        reg = <0>;
+        spi-max-frequency = <1000000>;
+        clocks = <&mca0>;
+        clock-names = "mclk";
+        mute-gpios = <&pinctrl_ap 64 GPIO_ACTIVE_LOW>;
+        #sound-dai-cells = <0>;
+      };
+    };
