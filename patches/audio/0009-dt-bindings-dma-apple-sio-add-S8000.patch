From c037b6f7c0a3a0b3c0ab32ec98cdb4a6f5889b6c Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Thu, 22 Oct 2026 12:29:29 +0000
Subject: [PATCH 09/17] dt-bindings: dma: apple,sio: add S8000

The A9 (S8000/S8003) SmartIO is the same AppleA7IOPV1 coprocessor
(iop-version 1) with the same firmware protocol as T8010's. Add the
compatible, the power-state reset used when the coprocessor is found
running, an optional list of firmware endpoints to expose, and MCA0
transmit (0x28) as an example endpoint.

Co-Authored-By: Claude Opus 5.5 <maintainer@example.invalid>
---
 .../devicetree/bindings/dma/apple,sio.yaml    | 26 +++++++++++++++----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/dma/apple,sio.yaml b/Documentation/devicetree/bindings/dma/apple,sio.yaml
index 085d298727..9595e6df24 100644
--- a/Documentation/devicetree/bindings/dma/apple,sio.yaml
+++ b/Documentation/devicetree/bindings/dma/apple,sio.yaml
@@ -4,11 +4,11 @@
 $id: http://devicetree.org/schemas/dma/apple,sio.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple T8010 SmartIO coprocessor and DMA controller
+title: Apple S8000/T8010 SmartIO coprocessor and DMA controller
 
 description: |
-  The T8010 SmartIO coprocessor provides DMA channels for peripheral
-  controllers. The application processor boots the SmartIO firmware and
+  The S8000 (A9) and T8010 (A10) SmartIO coprocessor provides DMA channels
+  for peripheral controllers. The application processor boots the SmartIO firmware and
   submits DMA commands through the SIO message queues. Clients select the
   firmware endpoint number used by their peripheral.
 
@@ -20,7 +20,9 @@ allOf:
 
 properties:
   compatible:
-    const: apple,t8010-sio
+    enum:
+      - apple,s8000-sio
+      - apple,t8010-sio
 
   reg:
     items:
@@ -41,6 +43,20 @@ properties:
   power-domains:
     maxItems: 1
 
+  resets:
+    maxItems: 1
+    description:
+      Power-state reset, used if the coprocessor is found already running.
+
+  apple,dma-endpoints:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    maxItems: 130
+    items:
+      maximum: 0x81
+    description:
+      Firmware endpoints exposed as DMA channels. Defaults to the SPI, MCA
+      and UART transmit and receive endpoints.
+
   firmware-name:
     maxItems: 1
 
@@ -51,7 +67,7 @@ properties:
     const: 1
     description:
       Clients specify the SmartIO DMA endpoint number, for example 0x1a for
-      SPI3 transmit and 0x1b for SPI3 receive.
+      SPI3 transmit, 0x1b for SPI3 receive or 0x28 for MCA0 transmit.
 
 required:
   - compatible
