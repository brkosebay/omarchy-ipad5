From a18b0e2ee18def3a2d6090e9dc8edd73beb3abd8 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Tue, 27 Oct 2026 18:26:06 +0000
Subject: [PATCH] power: supply: apple: prefer enumerated hosts over early BC
 detection

---
 .../ABI/testing/sysfs-apple-charge10          | 19 ++++++++++
 drivers/power/supply/apple_tristar_power.c    | 38 ++++++++++++++-----
 2 files changed, 48 insertions(+), 9 deletions(-)
 create mode 100644 Documentation/ABI/testing/sysfs-apple-charge10

diff --git a/Documentation/ABI/testing/sysfs-apple-charge10 b/Documentation/ABI/testing/sysfs-apple-charge10
new file mode 100644
index 0000000000..c56713ac2f
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-apple-charge10
@@ -0,0 +1,19 @@
+What:		/sys/bus/i2c/devices/*-001a/lightning_state
+Date:		October 2026
+Contact:	linux-a9 maintainers
+Description:
+		source_epoch adds computer_seen: a positive USB data session
+		(connected, configured, or host-granted gadget evidence) observed
+		in this source epoch. It persists across USB suspend/reset and is
+		cleared by the same VBUS/ID/phase boundaries as other source policy.
+		A real computer supersedes prior divider/BC1.2/CC source results:
+		usb_type becomes SDP, with the charger's generic board ceiling.
+		bc_ua/bc_type remain diagnostic evidence and cannot cap that host.
+
+		bc_primary_mv and bc_secondary_mv report the most recent BC pin
+		measurements, distinct from passive dp_mv/dm_mv. Negative values
+		are errno/unavailable. They are reset on a new source epoch and
+		retained during a CC-only refresh. For ordinary USB, secondary D+
+		below 326 mV means CDP, at/above 326 mV means DCP. These are pin
+		voltages, not VBUS. A never-enumerating source keeps its proven
+		BC1.2/CC allowance, bounded by the existing charger policy.
diff --git a/drivers/power/supply/apple_tristar_power.c b/drivers/power/supply/apple_tristar_power.c
index 1a2b4ff9c6..c97848d8fa 100644
--- a/drivers/power/supply/apple_tristar_power.c
+++ b/drivers/power/supply/apple_tristar_power.c
@@ -91,12 +91,15 @@ struct apple_tristar {
 	atomic_t reset_generation;
 	int seen_generation;
 	atomic_t usb_session;
+	atomic_t computer_seen;
 	atomic_t usb_events;
 	atomic_t usb_idle_events;
 	unsigned long usb_event_source;
 	int bc_ua;
 	int bc_type;
 	int cc_first_mv;
+	int bc_primary_mv;
+	int bc_secondary_mv;
 	u8 source_id[TRISTAR_AUTO_ID_LEN];
 	bool source_id_valid;
 	bool epoch_notify;
@@ -263,7 +266,8 @@ static bool apple_tristar_sample_valid(struct apple_tristar *ts)
 		ts->detect_stage = "usb-budget";
 		return false;
 	}
-	if (budget.connected || budget.configured || budget.host_grant) {
+	if (budget.connected || budget.configured || budget.host_grant ||
+	    atomic_read(&ts->computer_seen)) {
 		ts->detect_stage = "usb-active";
 		return false;
 	}
@@ -408,7 +412,8 @@ static void apple_tristar_classify(struct apple_tristar *ts)
 	bool typec = apple_tristar_typec_cable(ts);
 
 	/* Caller holds the role hardware lock before ts->lock. */
-	if (ts->computer || (ts->brick_sampled && !typec) || ts->adc_poisoned ||
+	if (ts->computer || atomic_read(&ts->computer_seen) ||
+	    (ts->brick_sampled && !typec) || ts->adc_poisoned ||
 	    !ts->online || ts->error || time_before(jiffies, ts->classify_after))
 		return;
 	ts->seen_generation = atomic_read(&ts->reset_generation);
@@ -474,6 +479,7 @@ static void apple_tristar_classify(struct apple_tristar *ts)
 	} else {
 		/* iOS 5de33e4/5de35dc, ordinary USB source (connect type 0). */
 		dm = apple_tristar_pin_mv(ts, true, true, false);
+		ts->bc_primary_mv = dm;
 		if (dm < 0) {
 			ret = dm;
 			goto fail;
@@ -485,6 +491,7 @@ static void apple_tristar_classify(struct apple_tristar *ts)
 		}
 		if (dm >= 326 && dm <= 899) {
 			dp = apple_tristar_pin_mv(ts, false, true, false);
+			ts->bc_secondary_mv = dp;
 			if (dp < 0) {
 				ret = dp;
 				goto fail;
@@ -494,7 +501,8 @@ static void apple_tristar_classify(struct apple_tristar *ts)
 				ret = -ERANGE;
 				goto fail;
 			}
-			type = dp < 326 ? POWER_SUPPLY_USB_TYPE_DCP : POWER_SUPPLY_USB_TYPE_CDP;
+			/* iOS internal 2=CDP, 1=DCP (type names at 6de2df0). */
+			type = dp < 326 ? POWER_SUPPLY_USB_TYPE_CDP : POWER_SUPPLY_USB_TYPE_DCP;
 			ret = 1500000;
 		}
 	}
@@ -610,9 +618,12 @@ static void apple_tristar_new_source(struct apple_tristar *ts, const char *reaso
 	ts->epoch_notify = true;
 	ts->source_id_valid = false;
 	ts->computer = false;
+	atomic_set(&ts->computer_seen, 0);
 	ts->brick_sampled = false;
 	ts->brick_ua = 0;
 	ts->bc_ua = 0;
+	ts->bc_primary_mv = -ENODATA;
+	ts->bc_secondary_mv = -ENODATA;
 	ts->bc_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
 	ts->analog_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
 	ts->current_ua = APPLE_TRISTAR_FLOOR_UA;
@@ -711,6 +722,11 @@ static int apple_tristar_update(struct apple_tristar *ts)
 		current_ua = auto_ua;
 		type = POWER_SUPPLY_USB_TYPE_ACA;
 	} else if (online && !error) {
+		/* Positive USB session evidence outranks every earlier analog result. */
+		if (atomic_read(&ts->computer_seen)) {
+			ts->computer = true;
+			ts->brick_ua = 0;
+		}
 		if (usb_gadget_get_current_budget(ts->usb_node, &budget)) {
 			current_ua = apple_tristar_budget(NULL, 0, &type);
 			if (ts->computer) {
@@ -721,10 +737,8 @@ static int apple_tristar_update(struct apple_tristar *ts)
 				current_ua = ts->brick_ua;
 			}
 		} else {
-			if ((budget.connected || budget.configured || budget.host_grant) &&
-			    (!ts->brick_ua ||
-			     (ts->analog_type == POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID ||
-			      ts->analog_type == POWER_SUPPLY_USB_TYPE_C))) {
+			if (budget.connected || budget.configured || budget.host_grant) {
+				atomic_set(&ts->computer_seen, 1);
 				ts->computer = true;
 				ts->brick_ua = 0;
 			}
@@ -820,6 +834,8 @@ static int apple_tristar_usb_event(struct notifier_block *nb, unsigned long even
 	atomic_inc(&ts->usb_events);
 	if (budget->connected || budget->configured || budget->host_grant) {
 		atomic_set(&ts->usb_session, 1);
+		/* Retain a short session even if it ends before the next worker. */
+		atomic_set(&ts->computer_seen, 1);
 		atomic_inc(&ts->reset_generation);
 	} else if (atomic_xchg(&ts->usb_session, 0)) {
 		/* A short real session ending between two samples still cancels. */
@@ -1659,11 +1675,12 @@ static ssize_t lightning_state_show(struct device *dev, struct device_attribute
 			     ts->cc_mv, ts->brick_sampled, ts->adc_fault_stage ?: "none",
 			     ts->adc_fault_attach);
 	len += sysfs_emit_at(buf, len,
-			     "source_epoch: id=%u reason=%s bc_ua=%d bc_type=%d cc_first_mv=%d usb_events=%d usb_idle_events=%d usb_generation=%d usb_event_source=%lu\n",
+			     "source_epoch: id=%u reason=%s bc_ua=%d bc_type=%d cc_first_mv=%d usb_events=%d usb_idle_events=%d usb_generation=%d usb_event_source=%lu computer_seen=%d bc_primary_mv=%d bc_secondary_mv=%d\n",
 			     ts->attach_id, ts->epoch_reason ?: "boot", ts->bc_ua, ts->bc_type,
 			     ts->cc_first_mv, atomic_read(&ts->usb_events),
 			     atomic_read(&ts->usb_idle_events), atomic_read(&ts->reset_generation),
-			     READ_ONCE(ts->usb_event_source));
+			     READ_ONCE(ts->usb_event_source), atomic_read(&ts->computer_seen),
+			     ts->bc_primary_mv, ts->bc_secondary_mv);
 	mutex_unlock(&ts->lock);
 
 	len += sysfs_emit_at(buf, len, "auto_host: %d\nphase: %s\nrole: %s%s\n",
@@ -1839,6 +1856,8 @@ static int apple_tristar_probe(struct i2c_client *client)
 	ts->dp_mv = -ENODATA;
 	ts->dm_mv = -ENODATA;
 	ts->cc_mv = -ENODATA;
+	ts->bc_primary_mv = -ENODATA;
+	ts->bc_secondary_mv = -ENODATA;
 	ts->detect_stage = "initial";
 	tristar_auto_init(&ts->autop);
 	i2c_set_clientdata(client, ts);
@@ -1884,6 +1903,7 @@ static int apple_tristar_probe(struct i2c_client *client)
 		return ret;
 	atomic_set(&ts->reset_generation, 0);
 	atomic_set(&ts->usb_session, 0);
+	atomic_set(&ts->computer_seen, 0);
 	atomic_set(&ts->usb_events, 0);
 	atomic_set(&ts->usb_idle_events, 0);
 	/* Allow old iOS work to quiesce; no first-boot ADC idle bit is known. */
