+/*
+ * After a re-entry from Linux, a secondary that Linux offlined waits in the
+ * PSCI pen at EL3 rather than in smp_secondary_entry(). It can't be reset
+ * through the PMGR (it is running), so hand it an EL1 entry with CPU_ON.
+ */
+static bool smp_reclaim_cpu(int index, u64 mpidr)
+{
+    int i;
+
+    if (index >= MAX_CPUS || spin_table[index].flag)
+        return false;
+
+    if (psci_affinity_info(mpidr) != PSCI_AFF_OFF)
+        return false;
+
+    printf("Taking CPU %d back from the PSCI pen... ", index);
+
+    memset(&spin_table[index], 0, sizeof(struct spin_table));
+    target_cpu = index;
+    secondary_stacks[index] = memalign(0x4000, SECONDARY_STACK_SIZE);
+
+    /* The core starts with its MMU off */
+    dc_civac_range(&spin_table[index], sizeof(struct spin_table));
+    dc_civac_range(&target_cpu, sizeof(target_cpu));
+    dc_civac_range(&boot_cpu_idx, sizeof(boot_cpu_idx));
+    dc_civac_range(&boot_cpu_mpidr, sizeof(boot_cpu_mpidr));
+
+    if (psci_unpark_cpu(index, mpidr, secondary_stacks[index] + SECONDARY_STACK_SIZE) < 0) {
+        printf("Failed (CPU_ON)\n");
+        return true;
+    }
+
+    for (i = 0; i < 100; i++) {
+        sysop("dmb ld");
+        if (spin_table[index].flag)
+            break;
+        udelay(1000);
+    }
+
+    printf("%s\n", i >= 100 ? "Failed!" : "  Back.");
+    return true;
+}
+
+/*
+ * Put every live secondary into the PSCI pen, for a kernel that boots them
+ * with enable-method = "psci". A CPU that doesn't make it is dropped (and
+ * then pruned from the DT by the caller).
+ */
+int smp_park_secondaries_psci(void)
+{
+    int parked = 0;
+
+    for (int i = 0; i < MAX_CPUS; i++) {
+        if (i == boot_cpu_idx || !smp_is_alive(i))
+            continue;
+
+        u64 mpidr = spin_table[i].mpidr;
+        if (psci_park_cpu(i, mpidr) < 0) {
+            printf("PSCI: CPU %d (MPIDR 0x%lx) did not park, dropping it\n", i, mpidr);
+            memset(&spin_table[i], 0, sizeof(struct spin_table));
+            continue;
+        }
+        parked++;
+    }
+
+    return parked;
+}
