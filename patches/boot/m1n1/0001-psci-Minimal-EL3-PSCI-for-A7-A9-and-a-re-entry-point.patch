diff --git a/src/psci.c b/src/psci.c
new file mode 100644
index 0000000..2b8ca0d
--- /dev/null
+++ b/src/psci.c
@@ -0,0 +1,229 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "psci.h"
+#include "smp.h"
+#include "types.h"
+#include "utils.h"
+
+struct psci_cpu {
+    volatile u64 state;
+    volatile u64 entry;
+    volatile u64 context;
+    u64 pad[PSCI_CPU_SIZE / 8 - 3];
+};
+
+_Static_assert(sizeof(struct psci_cpu) == PSCI_CPU_SIZE, "psci_cpu layout");
+
+/*
+ * Mailboxes, one cache line each, only ever accessed at EL3 with the MMU off.
+ * They live in .data rather than .bss so that a parked CPU's state survives
+ * m1n1 being re-entered from Linux (which clears .bss).
+ */
+struct psci_cpu psci_cpus[PSCI_MAX_CPUS]
+    __attribute__((section(".data"), aligned(PSCI_CPU_SIZE)));
+
+/* Written with the MMU off only (_reentry sets reentry_flag, the first member) */
+struct {
+    u64 reentry_flag;
+    u64 boot_el3;
+} psci_persist __attribute__((section(".data"), aligned(PSCI_CPU_SIZE)));
+
+/* psci=1 from the payload, kept across a re-entry */
+static u32 psci_mode __attribute__((section(".data")));
+
+/* EL3 stacks a CPU gets when it leaves the pen */
+static u8 psci_stacks[PSCI_MAX_CPUS][PSCI_STACK_SIZE] __attribute__((aligned(16)));
+
+static bool psci_have_el3;
+static bool reentered;
+
+/* EL3 side */
+
+static inline void psci_line_sync(volatile void *p)
+{
+    __asm__ volatile("dc civac, %0\n\tdsb sy" ::"r"(p) : "memory");
+}
+
+static int psci_mpidr_index(u64 mpidr)
+{
+    mpidr &= 0xff00ffffffUL;
+
+    /* A7-A9: one cluster, Aff0 is the core */
+    if (mpidr >= PSCI_MAX_CPUS)
+        return -1;
+
+    return mpidr;
+}
+
+static s64 psci_cpu_off(void)
+{
+    int idx = psci_mpidr_index(mrs(MPIDR_EL1));
+
+    if (idx < 0)
+        return PSCI_RET_DENIED;
+
+    psci_pen(&psci_cpus[idx], (u64)&psci_stacks[idx][PSCI_STACK_SIZE]);
+}
+
+static s64 psci_cpu_on(u64 mpidr, u64 entry, u64 context)
+{
+    int idx = psci_mpidr_index(mpidr);
+
+    if (idx < 0 || !entry)
+        return PSCI_RET_INVALID_PARAMS;
+
+    struct psci_cpu *c = &psci_cpus[idx];
+
+    psci_line_sync(c);
+    switch (c->state) {
+        case PSCI_AFF_OFF:
+            break;
+        case PSCI_AFF_ON_PENDING:
+            return PSCI_RET_ON_PENDING;
+        default:
+            /* Running, or never seen by us (still in m1n1 or never started) */
+            return PSCI_RET_ALREADY_ON;
+    }
+
+    /* State before entry: the pen sets ON as soon as it sees the entry */
+    c->context = context;
+    c->state = PSCI_AFF_ON_PENDING;
+    psci_line_sync(c);
+    c->entry = entry;
+    psci_line_sync(c);
+    sysop("sev");
+
+    return PSCI_RET_SUCCESS;
+}
+
+static s64 psci_affinity(u64 mpidr, u64 level)
+{
+    int idx = psci_mpidr_index(mpidr);
+
+    if (idx < 0 || level)
+        return PSCI_RET_INVALID_PARAMS;
+
+    psci_line_sync(&psci_cpus[idx]);
+    return psci_cpus[idx].state;
+}
+
+static s64 psci_features(u32 fid)
+{
+    switch (fid) {
+        case PSCI_0_2_FN_PSCI_VERSION:
+        case PSCI_0_2_FN_CPU_OFF:
+        case PSCI_0_2_FN_CPU_ON:
+        case PSCI_0_2_FN64_CPU_ON:
+        case PSCI_0_2_FN_AFFINITY_INFO:
+        case PSCI_0_2_FN64_AFFINITY_INFO:
+        case PSCI_0_2_FN_MIGRATE_INFO_TYPE:
+        case PSCI_1_0_FN_PSCI_FEATURES:
+            return PSCI_RET_SUCCESS;
+        default:
+            /*
+             * Includes SMCCC_VERSION (so callers assume SMCCC 1.0 and make
+             * no other SMCs), CPU_SUSPEND, SYSTEM_OFF and SYSTEM_RESET.
+             */
+            return PSCI_RET_NOT_SUPPORTED;
+    }
+}
+
+u64 psci_handle(u64 fid, u64 a1, u64 a2, u64 a3)
+{
+    u32 fn = fid;
+
+    /* SMC32 calls carry 32-bit arguments */
+    if (!(fn & 0x40000000)) {
+        a1 = (u32)a1;
+        a2 = (u32)a2;
+        a3 = (u32)a3;
+    }
+
+    switch (fn) {
+        case PSCI_0_2_FN_PSCI_VERSION:
+            return 0x10000; /* 1.0 */
+        case PSCI_0_2_FN_CPU_OFF:
+            return psci_cpu_off();
+        case PSCI_0_2_FN_CPU_ON:
+        case PSCI_0_2_FN64_CPU_ON:
+            return psci_cpu_on(a1, a2, a3);
+        case PSCI_0_2_FN_AFFINITY_INFO:
+        case PSCI_0_2_FN64_AFFINITY_INFO:
+            return psci_affinity(a1, a2);
+        case PSCI_0_2_FN_MIGRATE_INFO_TYPE:
+            return 2; /* no trusted OS, nothing to migrate */
+        case PSCI_1_0_FN_PSCI_FEATURES:
+            return psci_features(a1);
+        default:
+            /* SYSTEM_RESET/SYSTEM_OFF too: the caller falls back to its own */
+            return PSCI_RET_NOT_SUPPORTED;
+    }
+}
+
+/* EL1 side */
+
+void psci_note_boot_el(u64 el)
+{
+    /* MMU still off: these .data accesses are uncached, like the writers' */
+    if (psci_persist.reentry_flag) {
+        reentered = true;
+        psci_persist.reentry_flag = 0;
+    }
+    if (el == 3)
+        psci_persist.boot_el3 = 1;
+
+    psci_have_el3 = psci_persist.boot_el3 && has_el3();
+}
+
+void psci_configure(const char *val)
+{
+    psci_mode = val[0] == '1';
+}
+
+bool psci_active(void)
+{
+    return psci_mode && psci_have_el3;
+}
+
+bool psci_reentered(void)
+{
+    return reentered;
+}
+
+int psci_affinity_info(u64 mpidr)
+{
+    return psci_smc(PSCI_0_2_FN64_AFFINITY_INFO, mpidr, 0, 0);
+}
+
+static void psci_self_off(void)
+{
+    /* Only returns on failure; the core then stays in m1n1's loop */
+    psci_smc(PSCI_0_2_FN_CPU_OFF, 0, 0, 0);
+}
+
+int psci_park_cpu(int cpu, u64 mpidr)
+{
+    if (psci_affinity_info(mpidr) == PSCI_AFF_OFF)
+        return 0;
+
+    smp_call0(cpu, psci_self_off);
+
+    for (int i = 0; i < 100; i++) {
+        if (psci_affinity_info(mpidr) == PSCI_AFF_OFF)
+            return 0;
+        udelay(1000);
+    }
+
+    return -1;
+}
+
+int psci_unpark_cpu(int index, u64 mpidr, void *stack_top)
+{
+    if (psci_affinity_info(mpidr) != PSCI_AFF_OFF)
+        return -1;
+
+    s64 ret = psci_smc(PSCI_0_2_FN64_CPU_ON, mpidr, (u64)psci_secondary_entry,
+                       (u64)stack_top | (u64)index);
+
+    return ret == PSCI_RET_SUCCESS ? 0 : -1;
+}
diff --git a/src/psci.h b/src/psci.h
new file mode 100644
index 0000000..6769ebe
--- /dev/null
+++ b/src/psci.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef PSCI_H
+#define PSCI_H
+
+#ifndef __ASSEMBLER__
+#include "types.h"
+#endif
+
+/*
+ * Minimal PSCI 1.0 for SoCs where m1n1 owns EL3 (A7-A9 entered at EL3).
+ * Only CPU_ON/CPU_OFF/AFFINITY_INFO and the discovery calls are implemented.
+ * A CPU that calls CPU_OFF is not powered down: it waits at EL3, MMU and
+ * caches off, until CPU_ON hands it a new EL1 entry point. That is what the
+ * kernel needs to offline CPUs for kexec and CPU hotplug.
+ */
+
+#define PSCI_0_2_FN_PSCI_VERSION      0x84000000
+#define PSCI_0_2_FN_CPU_SUSPEND       0x84000001
+#define PSCI_0_2_FN_CPU_OFF           0x84000002
+#define PSCI_0_2_FN_CPU_ON            0x84000003
+#define PSCI_0_2_FN_AFFINITY_INFO     0x84000004
+#define PSCI_0_2_FN_MIGRATE_INFO_TYPE 0x84000006
+#define PSCI_0_2_FN_SYSTEM_OFF        0x84000008
+#define PSCI_0_2_FN_SYSTEM_RESET      0x84000009
+#define PSCI_1_0_FN_PSCI_FEATURES     0x8400000a
+#define PSCI_0_2_FN64_CPU_ON          0xc4000003
+#define PSCI_0_2_FN64_AFFINITY_INFO   0xc4000004
+
+#define PSCI_RET_SUCCESS            0
+#define PSCI_RET_NOT_SUPPORTED      -1
+#define PSCI_RET_INVALID_PARAMS     -2
+#define PSCI_RET_DENIED             -3
+#define PSCI_RET_ALREADY_ON         -4
+#define PSCI_RET_ON_PENDING         -5
+#define PSCI_RET_INTERNAL_FAILURE   -6
+
+#define PSCI_AFF_ON         0
+#define PSCI_AFF_OFF        1
+#define PSCI_AFF_ON_PENDING 2
+
+#define PSCI_MAX_CPUS   4
+#define PSCI_STACK_SIZE 0x4000
+
+/* Layout shared with psci_asm.S */
+#define PSCI_CPU_STATE   0x00
+#define PSCI_CPU_ENTRY   0x08
+#define PSCI_CPU_CONTEXT 0x10
+#define PSCI_CPU_SIZE    0x80
+
+#ifndef __ASSEMBLER__
+
+/* Payload variable psci=1 */
+void psci_configure(const char *val);
+/* m1n1 entered at EL3 and psci=1 given: the kernel may use PSCI */
+bool psci_active(void);
+/* Called once from _start_c with the EL m1n1 was entered at */
+void psci_note_boot_el(u64 el);
+/* Set when m1n1 was re-entered from Linux (see psci_asm.S _reentry) */
+bool psci_reentered(void);
+
+/* EL1 side: SMC into our own EL3 */
+s64 psci_smc(u64 fid, u64 a1, u64 a2, u64 a3);
+int psci_affinity_info(u64 mpidr);
+/* Park a secondary that is spinning in smp_secondary_entry() at EL3 */
+int psci_park_cpu(int cpu, u64 mpidr);
+/* Bring a parked CPU back into m1n1 (re-entry); returns 0 if it was parked */
+int psci_unpark_cpu(int index, u64 mpidr, void *stack_top);
+
+/* EL3 side */
+u64 psci_handle(u64 fid, u64 a1, u64 a2, u64 a3);
+void psci_pen(void *cpu, u64 stack_top) __attribute__((noreturn));
+void psci_secondary_entry(void);
+void _reentry(void);
+
+#endif
+
+#endif
diff --git a/src/psci_asm.S b/src/psci_asm.S
new file mode 100644
index 0000000..14f842f
--- /dev/null
+++ b/src/psci_asm.S
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "psci.h"
+
+#define DCSW_OP_DCCISW 0x1 // memory.h
+
+.extern _v_sp0_sync
+.extern _start
+.extern _cpu_reset_c
+.extern psci_handle
+.extern psci_persist
+
+.text
+
+/*
+ * Lower-EL synchronous exceptions. At EL3, an SMCCC call (smc #0 from EL1)
+ * goes to the PSCI dispatcher; everything else, and every exception taken
+ * at EL1/EL2, takes the usual path.
+ */
+.globl _v_lower_sync
+.type _v_lower_sync, @function
+_v_lower_sync:
+    stp x16, x17, [sp, #-16]!
+    mrs x16, CurrentEL
+    cmp x16, #0xc
+    b.ne 1f
+    mrs x16, esr_el3
+    lsr x17, x16, #26
+    cmp x17, #0x17 // EC: SMC from AArch64
+    b.ne 1f
+    tst x16, #0xffff // imm16 == 0: SMCCC
+    b.ne 1f
+    ldp x16, x17, [sp], #16
+    b psci_smc_entry
+1:
+    ldp x16, x17, [sp], #16
+    b _v_sp0_sync
+
+/*
+ * SMCCC 1.0: x0-x17 may be clobbered, x18-x30 and SP_EL1 belong to the
+ * caller. x0-x3 go straight to psci_handle(). ELR/SPSR are saved in case
+ * anything below takes an exception at EL3.
+ */
+.type psci_smc_entry, @function
+psci_smc_entry:
+    stp x29, x30, [sp, #-16]!
+    mrs x29, elr_el3
+    mrs x30, spsr_el3
+    stp x29, x30, [sp, #-16]!
+    str x18, [sp, #-16]!
+    bl psci_handle
+    ldr x18, [sp], #16
+    ldp x29, x30, [sp], #16
+    msr elr_el3, x29
+    msr spsr_el3, x30
+    ldp x29, x30, [sp], #16
+    eret
+
+/*
+ * psci_pen(struct psci_cpu *me, u64 stack_top): CPU_OFF. Never returns.
+ *
+ * The core is not powered down. It writes its L1D back, marks itself OFF and
+ * waits in WFE at EL3 (MMU off, so every access here is non-cacheable) for
+ * CPU_ON to post an entry point. It then enters EL1 there with the MMU off,
+ * a clean I-cache and TLB, and x0 = context id, like a core coming out of
+ * reset. SP_EL3 is reset to this core's own static stack.
+ */
+.globl psci_pen
+.type psci_pen, @function
+psci_pen:
+    mov x19, x0
+    mov x20, x1
+
+    // A pending timer interrupt must not keep waking WFE.
+    msr cntp_ctl_el0, xzr
+    msr cntv_ctl_el0, xzr
+    isb
+
+    // Clean and invalidate this core's L1D (L2 is shared and coherent).
+    mov x0, #DCSW_OP_DCCISW
+    bl dcsw_op_level1
+    dsb sy
+
+    str xzr, [x19, #PSCI_CPU_ENTRY]
+    mov x1, #PSCI_AFF_OFF
+    str x1, [x19, #PSCI_CPU_STATE]
+    dc civac, x19
+    dsb sy
+    sev
+
+1:
+    wfe
+    dc civac, x19
+    dsb sy
+    ldr x2, [x19, #PSCI_CPU_ENTRY]
+    cbz x2, 1b
+
+    ldr x0, [x19, #PSCI_CPU_CONTEXT]
+    str xzr, [x19, #PSCI_CPU_ENTRY]
+    mov x1, #PSCI_AFF_ON
+    str x1, [x19, #PSCI_CPU_STATE]
+    dc civac, x19
+    dsb sy
+
+    // Nothing of the previous kernel's EL1 context may survive.
+    ic iallu
+    tlbi alle1
+    dsb sy
+    mov x1, #0x0800 // SCTLR_EL1: RES1 bits only, MMU and caches off
+    movk x1, #0x30d0, lsl #16
+    msr sctlr_el1, x1
+    mov x1, #0x3c5 // EL1h, DAIF masked
+    msr spsr_el3, x1
+    msr elr_el3, x2
+    mov sp, x20
+    isb
+    eret
+
+/* EL1 side: s64 psci_smc(u64 fid, u64 a1, u64 a2, u64 a3) */
+.globl psci_smc
+.type psci_smc, @function
+psci_smc:
+    smc #0
+    ret
+
+/*
+ * CPU_ON target when m1n1 takes a parked core back after a re-entry.
+ * x0 = EL1 stack top | m1n1 CPU index (stack tops are 16 KiB aligned).
+ */
+.globl psci_secondary_entry
+.type psci_secondary_entry, @function
+psci_secondary_entry:
+    and x1, x0, #0xf
+    bic x0, x0, #0xf
+    msr tpidr_el1, x1
+    mov sp, x0
+    bl _cpu_reset_c
+    b .
+
+/*
+ * Re-entry from Linux (a kexec'd trampoline, see docs/boot/warm-reboot.md):
+ * EL1, MMU and caches off, x0 = a copy of the original boot_args.
+ * Linux may hold clean lines of this image in its linear map, so drop them
+ * before m1n1 writes its .bss uncached and then reads it with caches on.
+ */
+.globl _reentry
+.type _reentry, @function
+_reentry:
+    mov x19, x0
+    adrp x1, _base
+    adrp x2, _end
+1:
+    dc civac, x1
+    add x1, x1, #64
+    cmp x1, x2
+    b.lo 1b
+    dsb sy
+    ic iallu
+    dsb sy
+    isb
+
+    adrp x1, psci_persist // .reentry_flag
+    add x1, x1, :lo12:psci_persist
+    mov x2, #1
+    str x2, [x1]
+    dc civac, x1
+    dsb sy
+
+    mov x0, x19
+    b _start
