diff --git a/src/kboot.c b/src/kboot.c
index 9240ce2..b52e326 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -20,6 +20,7 @@
 #include "memory.h"
 #include "pcie.h"
 #include "pmgr.h"
+#include "psci.h"
 #include "sep.h"
 #include "sio.h"
 #include "smc.h"
@@ -585,6 +586,53 @@ static int dt_set_smbios(void)
     return 0;
 }
 
+/*
+ * With psci=1 and m1n1 owning EL3 (A7-A9), CPUs boot through m1n1's PSCI
+ * (see psci.c) instead of the spin table, so the kernel can offline them
+ * for kexec and CPU hotplug. Also tells Linux how to re-enter m1n1.
+ */
+static int dt_set_psci(void)
+{
+    static const char compat[] = "arm,psci-1.0\0arm,psci-0.2";
+    int node;
+
+    if (!psci_active()) {
+        printf("PSCI: off (needs psci=1 and m1n1 entered at EL3)\n");
+        return 0;
+    }
+
+    int cpus = fdt_path_offset(dt, "/cpus");
+    if (cpus < 0)
+        bail("FDT: /cpus node not found in devtree\n");
+
+    fdt_for_each_subnode(node, dt, cpus)
+    {
+        if (strncmp(fdt_get_name(dt, node, NULL), "cpu@", 4))
+            continue;
+        if (fdt_setprop_string(dt, node, "enable-method", "psci"))
+            bail("FDT: couldn't set enable-method\n");
+    }
+
+    node = fdt_path_offset(dt, "/psci");
+    if (node < 0)
+        node = fdt_add_subnode(dt, 0, "psci");
+    if (node < 0)
+        bail("FDT: couldn't add /psci\n");
+    if (fdt_setprop(dt, node, "compatible", compat, sizeof(compat)) ||
+        fdt_setprop_string(dt, node, "method", "smc"))
+        bail("FDT: couldn't fill /psci\n");
+
+    node = fdt_path_offset(dt, "/chosen");
+    if (node < 0)
+        bail("FDT: /chosen node not found in devtree\n");
+    if (fdt_setprop_u64(dt, node, "linux-a9,m1n1-reentry", (u64)_reentry) ||
+        fdt_setprop(dt, node, "linux-a9,m1n1-boot-args", &cur_boot_args, sizeof(cur_boot_args)))
+        bail("FDT: couldn't set the m1n1 re-entry properties\n");
+
+    printf("PSCI: on, enable-method = \"psci\", m1n1 re-entry at %p\n", _reentry);
+    return 0;
+}
+
 static int dt_set_cpus(void)
 {
     int ret = 0;
@@ -598,6 +646,10 @@ static int dt_set_cpus(void)
     if (!pruned_phandles)
         bail("FDT: out of memory\n");
 
+    /* Secondaries wait in the PSCI pen; one that can't get there is pruned below */
+    if (psci_active())
+        printf("PSCI: parked %d secondary CPU(s)\n", smp_park_secondaries_psci());
+
     /* Prune CPU nodes */
     int node, cpu = 0;
     for (node = fdt_first_subnode(dt, cpus); node >= 0;) {
@@ -629,7 +681,7 @@ static int dt_set_cpus(void)
         } else {
             printf("FDT: Reserving stack for CPU %d 0x%lx\n", cpu, (uint64_t)secondary_stacks[cpu]);
             fdt_add_mem_rsv(dt, (uint64_t)secondary_stacks[cpu], SECONDARY_STACK_SIZE);
-            if (has_el3()) {
+            if (has_el3() && secondary_stacks_el3[cpu]) {
                 printf("FDT: Reserving EL3 stack for CPU %d 0x%lx\n", cpu,
                        (uint64_t)secondary_stacks_el3[cpu]);
                 fdt_add_mem_rsv(dt, (uint64_t)secondary_stacks_el3[cpu], SECONDARY_STACK_SIZE);
@@ -3018,6 +3070,8 @@ int kboot_prepare_dt(void *fdt)
         return -1;
     if (dt_set_cpus())
         return -1;
+    if (dt_set_psci())
+        return -1;
     if (dt_set_mac_addresses())
         return -1;
     if (dt_set_wifi())
