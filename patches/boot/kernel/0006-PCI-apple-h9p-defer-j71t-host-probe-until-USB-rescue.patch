From 3f94cbe2591ed26d13b263c2337b058a96df6aa4 Mon Sep 17 00:00:00 2001
From: linux-a9 <linux-a9@localhost>
Date: Fri, 23 Oct 2026 08:22:51 +0000
Subject: [PATCH 6/6] PCI: apple-h9p: defer j71t host probe until USB rescue is
 ready

Extend the existing early-USB option to gate PCIe host setup before any resource allocation or MMIO. ANS-only deferral cannot expose a link-training or host-probe stall to initramfs. Userspace opens both gates and reprobes the host in a background worker after USB rescue/logging is available. Other boards retain their existing probe policy.
---
 drivers/nvme/host/Kconfig               | 13 +++++++------
 drivers/pci/controller/pcie-apple-h9p.c |  9 +++++++++
 2 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/drivers/nvme/host/Kconfig b/drivers/nvme/host/Kconfig
index 7846bc7a61..e8403ff125 100644
--- a/drivers/nvme/host/Kconfig
+++ b/drivers/nvme/host/Kconfig
@@ -15,14 +15,15 @@ config BLK_DEV_NVME
 	  module will be called nvme.
 
 config NVME_APPLE_ANS_EARLY_USB
-	bool "Defer j71t PCI ANS probe until early USB userspace is ready"
+	bool "Defer j71t PCIe/ANS probe until early USB userspace is ready"
 	depends on BLK_DEV_NVME && PCIE_APPLE_H9P
 	help
-	  Default nvme.apple_ans_probe to false on j71t. The boot initramfs
-	  must bring up USB logging/rescue access, set the parameter to true
-	  and write the endpoint BDF to /sys/bus/pci/drivers_probe. This keeps
-	  a fabric stall in ANS enable from hiding the failure before /init.
-	  Other boards are unchanged. Requires the linux-a9 boot initramfs.
+	  Default pcie_apple_h9p.probe and nvme.apple_ans_probe to false on
+	  j71t. The boot initramfs must bring up USB logging/rescue access,
+	  set both parameters to true and reprobe the platform PCIe host,
+	  then any deferred ANS endpoint. This allows /init to run even when
+	  the PCIe link fails before endpoint enumeration. Other boards are
+	  unchanged. Requires the linux-a9 boot initramfs.
 
 config NVME_PCI_READ_ONLY
 	bool "Refuse writes to NVMe PCI devices"
diff --git a/drivers/pci/controller/pcie-apple-h9p.c b/drivers/pci/controller/pcie-apple-h9p.c
index e52915fe17..3136234a72 100644
--- a/drivers/pci/controller/pcie-apple-h9p.c
+++ b/drivers/pci/controller/pcie-apple-h9p.c
@@ -236,6 +236,11 @@ MODULE_PARM_DESC(suspend,
 #define S8003_PORT_RESET_MS		100
 #define S8003_PORT_LINK_TRIES		2
 
+/* ANS-only deferral is too late to diagnose a stall in the host probe. */
+static bool h9p_probe = !IS_ENABLED(CONFIG_NVME_APPLE_ANS_EARLY_USB);
+module_param_named(probe, h9p_probe, bool, 0644);
+MODULE_PARM_DESC(probe, "Allow j71t PCIe host probe after initramfs USB rescue is ready");
+
 #define H9P_NVMMU_TCB_CTRL		0x0004
 #define H9P_NVMMU_TCB_CTRL_INIT	0x10000
 #define H9P_NVMMU_TCB_BASE_LO		0x0008
@@ -2213,6 +2218,10 @@ static int apple_h9p_pcie_probe(struct platform_device *pdev)
 	struct apple_h9p_pcie *pcie;
 	int ret;
 
+	if (!READ_ONCE(h9p_probe) && of_machine_is_compatible("apple,j71t"))
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for initramfs USB rescue (probe gate)\n");
+
 	bridge = devm_pci_alloc_host_bridge(dev, sizeof(*pcie));
 	if (!bridge)
 		return -ENOMEM;
-- 
