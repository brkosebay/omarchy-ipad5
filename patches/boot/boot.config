# Warm reboot (docs/boot/warm-reboot.md): kexec into the next kernel, and a
# crash kernel for kexec-on-panic. SMP kexec needs m1n1's PSCI
# (patches/boot/m1n1, payload variable psci=1); the kernel side is stock.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM_PSCI_FW=y
# Boot initramfs releases the j71t PCIe host and ANS after USB rescue is ready.
CONFIG_NVME_APPLE_ANS_EARLY_USB=y
# Reserved once in early j71t boot, preserved through both kexec hops.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=1048576
# Optional apple_boot_watchdog.timeout=120; initramfs disarms after a usable root.
CONFIG_APPLE_J71T_BOOT_WATCHDOG=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_DETECT_HUNG_TASK=y
