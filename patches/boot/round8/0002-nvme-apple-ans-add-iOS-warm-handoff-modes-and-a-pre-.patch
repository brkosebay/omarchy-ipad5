+		if (pcie->ans_mode == APPLE_ANS_FULL_CYCLE) {
+			/* Endpoint shutdown already set DART/NVMMU inactive. */
+			pcie->nvmmu.active = false;
+			gpiod_direction_output(pcie->perst[0], 1);
+			apple_s8003_port_stop(pcie, 0);
+			h9p_rmw(rc + S8003_RC_PORT_REFCLK(0),
+				S8003_RC_PORT_REFCLK_ON, 0);
+			udelay(S8003_PERST_TO_REFCLK_US);
+			h9p_rmw(rc + S8003_RC_PORT_PWR(0), S8003_RC_PORT_PWR_ON, 0);
+			h9p_rmw(rc + S8003_RC_PORT_CTL(0), S8003_RC_PORT_CTL_ENABLE, 0);
+		}
+		dev_info(pcie->dev, "Apple ANS: kexec %s; CC.EN/SHST retained\n",
+			 ans_boot_modes[pcie->ans_mode]);
