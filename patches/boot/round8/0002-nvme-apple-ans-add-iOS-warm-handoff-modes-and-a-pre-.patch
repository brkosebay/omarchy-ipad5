+static void apple_h9p_pcie_park(struct apple_h9p_pcie *pcie,
+				unsigned long ports)
+{
+	void __iomem *rc = pcie->base_rc;
+	void __iomem *cfg = pcie->base_config;
+
+	if (pcie->ans_mode != APPLE_ANS_ROUND7 && (ports & BIT(0))) {
