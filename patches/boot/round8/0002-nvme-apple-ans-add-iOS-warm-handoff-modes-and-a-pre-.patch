 	if (pci_enable_device_mem(pdev))
 		return result;
 
-	pci_set_master(pdev);
+	if (dev->dma_ops != &nvme_pci_apple_ans_ops ||
+	    apple_ans_boot_mode(dev->dev) == APPLE_ANS_ROUND7)
+		pci_set_master(pdev);
 
 	{
 		u32 csts;
@@ -3498,6 +3610,7 @@ static int nvme_pci_enable(struct nvme_dev *dev)
 			goto free_irq;
 	}
 
+	pci_set_master(pdev);
 	nvme_map_cmb(dev);
 
 	pci_save_state(pdev);
@@ -3526,6 +3639,9 @@ static bool nvme_pci_ctrl_is_dead(struct nvme_dev *dev)
 	struct pci_dev *pdev = to_pci_dev(dev->dev);
 	u32 csts;
 
+	if (test_bit(ANS_HEALTH_FAILED, &dev->apple_ans_flags))
+		return true;
+
 	if (!pci_is_enabled(pdev) || !pci_device_is_present(pdev))
 		return true;
 	if (pdev->error_state != pci_channel_io_normal)
@@ -3545,6 +3661,10 @@ static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
 
 	mutex_lock(&dev->shutdown_lock);
 	dead = nvme_pci_ctrl_is_dead(dev);
+	if (dead && shutdown && kexec_in_progress &&
+	    dev->dma_ops == &nvme_pci_apple_ans_ops &&
+	    apple_ans_boot_mode(dev->dev) != APPLE_ANS_ROUND7)
+		panic("Apple ANS: dead outgoing controller; refusing kexec");
 	if (state == NVME_CTRL_LIVE || state == NVME_CTRL_RESETTING) {
 		if (pci_is_enabled(pdev))
 			nvme_start_freeze(&dev->ctrl);
@@ -3552,13 +3672,28 @@ static void nvme_dev_disable(struct nvme_dev *dev, bool shutdown)
 		 * Give the controller a chance to complete all entered requests
 		 * if doing a safe shutdown.
 		 */
-		if (!dead && shutdown)
-			nvme_wait_freeze_timeout(&dev->ctrl);
+		if (!dead && shutdown) {
+			ret = nvme_wait_freeze_timeout(&dev->ctrl);
+			if (ret <= 0 && kexec_in_progress &&
+			    dev->dma_ops == &nvme_pci_apple_ans_ops &&
+			    apple_ans_boot_mode(dev->dev) != APPLE_ANS_ROUND7)
+				panic("Apple ANS: outgoing I/O did not drain; refusing kexec");
+		}
 	}
 
 	nvme_quiesce_io_queues(&dev->ctrl);
 
 	if (!dead && dev->ctrl.queue_count > 0) {
+		if (shutdown && kexec_in_progress &&
+		    dev->dma_ops == &nvme_pci_apple_ans_ops &&
+		    apple_ans_boot_mode(dev->dev) != APPLE_ANS_ROUND7) {
+			nvme_sync_io_queues(&dev->ctrl);
+			ret = apple_ans_nvmmu_drain(dev->dev);
+			if (ret) {
+				nvme_apple_ans_dump(dev, "outgoing drain failed");
+				panic("Apple ANS: outgoing drain failed %d; refusing kexec", ret);
+			}
+		}
 		nvme_delete_io_queues(dev);
 		if (shutdown && kexec_in_progress && dev->dma_ops &&
 		    dev->dma_ops->shutdown)
@@ -3633,6 +3768,19 @@ static void nvme_pci_free_ctrl(struct nvme_ctrl *ctrl)
 	kfree(dev);
 }
 
+static bool nvme_apple_ans_retry(struct nvme_dev *dev)
+{
+	if (dev->dma_ops != &nvme_pci_apple_ans_ops ||
+	    apple_ans_boot_mode(dev->dev) == APPLE_ANS_ROUND7 ||
+	    nvme_state_terminal(&dev->ctrl) ||
+	    test_and_set_bit(ANS_RECOVERY_USED, &dev->apple_ans_flags))
+		return false;
+	nvme_apple_ans_dump(dev, "health/enable failed before recovery");
+	pr_flush(1000, false);
+	set_bit(ANS_RECOVERY_PENDING, &dev->apple_ans_flags);
+	return true;
+}
+
 static void nvme_reset_work(struct work_struct *work)
 {
 	struct nvme_dev *dev =
@@ -3647,6 +3795,7 @@ static void nvme_reset_work(struct work_struct *work)
 		goto out;
 	}
 
+retry:
 	/*
 	 * If we're called to reset a live controller first shut it down before
 	 * moving on.
@@ -3654,6 +3803,13 @@ static void nvme_reset_work(struct work_struct *work)
 	if (dev->ctrl.ctrl_config & NVME_CC_ENABLE)
 		nvme_dev_disable(dev, false);
 	nvme_sync_queues(&dev->ctrl);
+	if (test_and_clear_bit(ANS_RECOVERY_PENDING, &dev->apple_ans_flags)) {
+		pci_clear_master(to_pci_dev(dev->dev));
+		result = nvme_pci_apple_ans_recover(dev);
+		if (result)
+			goto out;
+		clear_bit(ANS_HEALTH_FAILED, &dev->apple_ans_flags);
+	}
 
 	mutex_lock(&dev->shutdown_lock);
 	result = nvme_pci_enable(dev);
@@ -3673,7 +3829,8 @@ static void nvme_reset_work(struct work_struct *work)
 	 * Introduce CONNECTING state from nvme-fc/rdma transports to mark the
 	 * initializing procedure here.
 	 */
-	if (!nvme_change_ctrl_state(&dev->ctrl, NVME_CTRL_CONNECTING)) {
+	if (nvme_ctrl_state(&dev->ctrl) != NVME_CTRL_CONNECTING &&
+	    !nvme_change_ctrl_state(&dev->ctrl, NVME_CTRL_CONNECTING)) {
 		dev_warn(dev->ctrl.device,
 			"failed to mark controller CONNECTING\n");
 		result = -EBUSY;
@@ -3710,7 +3867,15 @@ static void nvme_reset_work(struct work_struct *work)
 	if (dev->online_queues > 1) {
 		nvme_dbbuf_set(dev);
 		nvme_unquiesce_io_queues(&dev->ctrl);
-		nvme_wait_freeze(&dev->ctrl);
+		if (dev->dma_ops == &nvme_pci_apple_ans_ops &&
+		    apple_ans_boot_mode(dev->dev) != APPLE_ANS_ROUND7) {
+			if (nvme_wait_freeze_timeout(&dev->ctrl) <= 0) {
+				result = -ETIMEDOUT;
+				goto out;
+			}
+		} else {
+			nvme_wait_freeze(&dev->ctrl);
+		}
 		if (!nvme_pci_update_nr_queues(dev))
 			goto out;
 		nvme_unfreeze(&dev->ctrl);
@@ -3722,6 +3887,13 @@ static void nvme_reset_work(struct work_struct *work)
 		nvme_free_tagset(dev);
 	}
 
+	if (dev->dma_ops == &nvme_pci_apple_ans_ops &&
+	    apple_ans_boot_mode(dev->dev) != APPLE_ANS_ROUND7) {
+		result = nvme_apple_ans_health(dev);
+		if (result)
+			goto out;
+	}
+
 	/*
 	 * If only admin queue live, keep it to do further investigation or
 	 * recovery.
@@ -3739,6 +3911,8 @@ static void nvme_reset_work(struct work_struct *work)
  out_unlock:
 	mutex_unlock(&dev->shutdown_lock);
  out:
+	if (nvme_apple_ans_retry(dev))
+		goto retry;
 	/*
 	 * Set state to deleting now to avoid blocking nvme_wait_reset(), which
 	 * may be holding this pci_dev's device lock.
diff --git a/drivers/pci/controller/pcie-apple-h9p.c b/drivers/pci/controller/pcie-apple-h9p.c
index 274433b04a..34f0409539 100644
--- a/drivers/pci/controller/pcie-apple-h9p.c
+++ b/drivers/pci/controller/pcie-apple-h9p.c
@@ -332,10 +332,41 @@ struct apple_h9p_hw {
 	void (*port_off)(struct apple_h9p_pcie *pcie, unsigned int port);
 };
 
+/* Round 8 is a supervised trial; round7 retains the previous sequence. */
+static enum apple_ans_boot_mode ans_boot_mode = APPLE_ANS_HANDOFF;
+static const char * const ans_boot_modes[] = { "round7", "handoff", "full-cycle" };
+
+static int ans_boot_mode_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ans_boot_modes); i++) {
+		if (!sysfs_streq(val, ans_boot_modes[i]))
+			continue;
+		*(enum apple_ans_boot_mode *)kp->arg = i;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int ans_boot_mode_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%s\n",
+		ans_boot_modes[*(enum apple_ans_boot_mode *)kp->arg]);
+}
+
+static const struct kernel_param_ops ans_boot_mode_ops = {
+	.set = ans_boot_mode_set,
+	.get = ans_boot_mode_get,
+};
+module_param_cb(ans_boot_mode, &ans_boot_mode_ops, &ans_boot_mode, 0444);
+MODULE_PARM_DESC(ans_boot_mode, "j71t ANS warm boot: handoff (trial default), full-cycle, round7");
+
 struct apple_h9p_nvmmu {
 	struct apple_h9p_pcie *pcie;
