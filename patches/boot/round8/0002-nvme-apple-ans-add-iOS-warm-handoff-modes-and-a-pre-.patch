@@ -1019,9 +1052,14 @@ static int apple_h9p_setup_nvmmu(struct apple_h9p_pcie *pcie)
 	if (!nvmmu->tcb_sgl)
 		return -ENOMEM;
 
-	ret = apple_h9p_nvmmu_program(pcie);
-	if (ret)
-		return dev_err_probe(dev, ret, "NVMMU: TCB init timeout\n");
+	/* Never replace inherited tables under an enabled controller. preinit
+	 * first stops it with CC=0, then programs our allocations.
+	 */
+	if (!pcie->ans_inherited) {
+		ret = apple_h9p_nvmmu_program(pcie);
